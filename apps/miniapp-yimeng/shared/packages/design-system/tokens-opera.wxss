/* 小戏小剧官方平台 · 设计 Token（小程序端）
   来源：docs/ux/OPERA_UI_VISUAL_BASELINE_V0.1 §2（现代中国文化门户：红金宣纸墨）
   页面禁止硬编码色值，一律引用 var(--ym-*)。 */

page {
  /* 沂蒙红（主色） */
  --ym-red-900: #4A0F13;
  --ym-red-700: #8B1E24;
  --ym-red-500: #B8484E;
  --ym-red-100: #F5E4E4;
  --ym-red-50: #FBF5F5;

  /* 金色（荣誉、专题、装饰线） */
  --ym-gold-700: #8C6E14;
  --ym-gold-500: #C9A227;
  --ym-gold-300: #E3CB7A;
  --ym-gold-100: #F7EFD8;

  /* 宣纸白（页面底）与卡片（2026-08-31 用户定稿 #fffff5） */
  --ym-paper: #fffff5;
  --ym-surface: #FFFFFF;

  /* 墨色文字 */
  --ym-ink: #1F1F1F;
  --ym-text: #3D3D3D;
  --ym-text-2: #6F6F6F;
  --ym-text-3: #9B9B9B;
  --ym-line: #E8E2D5;

  /* 阴影（仅两级） */
  --ym-shadow-rest: 0 2rpx 12rpx rgba(31, 31, 31, 0.06);
  --ym-shadow-float: 0 8rpx 24rpx rgba(31, 31, 31, 0.10);
}

page { background: #F7F7F5; color: #222222; font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif; }
.container { padding: 32rpx; box-sizing: border-box; padding-bottom: 50rpx; }
.card { background: #FFFFFF; border-radius: 20rpx; padding: 28rpx; box-shadow: 0 8rpx 24rpx rgba(0,0,0,.04); }
.title { font-size: 40rpx; font-weight: 700; }
.eyebrow { font-size: 23rpx; opacity: .8; margin-bottom: 12rpx; }
.subtitle { margin-top: 12rpx; color: #777777; font-size: 26rpx; line-height: 1.6; }
.hero { background: linear-gradient(140deg, #8E1730, #B23B4C); color: #FFFFFF; min-height: 280rpx; box-sizing: border-box; }
.hero-action { margin-top: 34rpx; display: inline-block; background: rgba(255,255,255,.16); border-radius: 999rpx; padding: 14rpx 20rpx; font-size: 24rpx; }
.section-title { margin: 36rpx 0 20rpx; font-size: 32rpx; font-weight: 650; }
.more { float: right; color: #9E1B32; font-size: 24rpx; font-weight: 400; }
.grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20rpx; }
.entry { min-height: 155rpx; display: flex; flex-direction: column; justify-content: flex-end; font-weight: 650; }
.entry-icon { width: 58rpx; height: 58rpx; border-radius: 16rpx; margin-bottom: 18rpx; display: flex; align-items: center; justify-content: center; background: #f7e9ed; color: #9E1B32; font-size: 22rpx; }
.muted { color: #888888; }
.search { background: #FFFFFF; border-radius: 999rpx; padding: 21rpx 28rpx; color: #999999; margin-top: 22rpx; box-shadow: 0 6rpx 20rpx rgba(0,0,0,.04); }
.content-card { margin-top: 16rpx; position: relative; }
.content-tag { display: inline-block; color: #9E1B32; background: #f8e9ed; padding: 6rpx 12rpx; border-radius: 8rpx; font-size: 21rpx; }
.content-title { margin-top: 12rpx; font-size: 29rpx; font-weight: 650; }
.content-arrow { position: absolute; right: 26rpx; top: 50%; transform: translateY(-50%); font-size: 40rpx; color: #aaa; }

@import '../../packages/design-system/tokens.wxss';

/* 基础主题按 YIMENG_UI_VISUAL_BASELINE_V0.2 token 化；旧页面遗留类待后续改版收口 */
page { background: var(--ymh-paper, #F2ECDF); color: var(--ymh-ink, #1F1F1F); font-family: "PingFang SC", "HarmonyOS Sans SC", "MiSans", -apple-system, sans-serif; }
.container { padding: 32rpx; box-sizing: border-box; padding-bottom: 56rpx; }
.card { background:#fff; border-radius:20rpx; padding:28rpx; box-shadow:0 8rpx 24rpx rgba(0,0,0,.04); box-sizing:border-box; }
.title { font-size:40rpx; font-weight:700; line-height:1.25; }
.eyebrow { font-size:23rpx; opacity:.84; margin-bottom:12rpx; }
.subtitle { margin-top:12rpx; color:#777; font-size:26rpx; line-height:1.6; }
.hero { background:linear-gradient(140deg,#8E1730,#B23B4C); color:#fff; min-height:300rpx; }
.hero-small { background:linear-gradient(140deg,#8E1730,#B23B4C); color:#fff; }
.hero-action { margin-top:34rpx; display:inline-block; background:rgba(255,255,255,.15); border-radius:999rpx; padding:14rpx 20rpx; font-size:24rpx; }
.search { background:#fff; border-radius:999rpx; padding:21rpx 28rpx; color:#999; margin-top:22rpx; box-shadow:0 6rpx 20rpx rgba(0,0,0,.04); }
.section-title { margin:36rpx 0 20rpx; font-size:32rpx; font-weight:650; }
.more { float:right; color:#9E1B32; font-size:24rpx; font-weight:400; }
.grid { display:grid; grid-template-columns:repeat(2,1fr); gap:20rpx; }
.grid-3 { grid-template-columns:repeat(3,1fr); margin-top:20rpx; gap:16rpx; }
.entry { min-height:155rpx; display:flex; flex-direction:column; justify-content:flex-end; font-weight:650; }
.entry-icon { width:58rpx; height:58rpx; border-radius:16rpx; margin-bottom:18rpx; display:flex; align-items:center; justify-content:center; background:#f7e9ed; color:#9E1B32; font-size:22rpx; }
.content-card { margin-top:16rpx; position:relative; padding-right:64rpx; }
.content-tag { display:inline-block; color:#9E1B32; background:#f8e9ed; padding:6rpx 12rpx; border-radius:8rpx; font-size:21rpx; }
.content-title { margin-top:12rpx; font-size:29rpx; font-weight:650; line-height:1.5; }
.content-summary { margin-top:8rpx; color:#777; font-size:24rpx; line-height:1.6; }
.content-arrow { position:absolute; right:26rpx; top:50%; transform:translateY(-50%); font-size:40rpx; color:#aaa; }
.stat { padding:22rpx 10rpx; text-align:center; }
.stat-number { font-size:36rpx; font-weight:700; color:#9E1B32; }
.muted { color:#888; }
.menu-row { display:flex; justify-content:space-between; align-items:center; margin-top:14rpx; font-size:27rpx; }
.version { text-align:center; font-size:22rpx; margin-top:30rpx; }

/* 首页：智能服务入口（弱化为末位，IA V1.0 §2）与官方页脚（V0.2 §5 OfficialFooter） */
.ai-entry { margin-top:36rpx; background:var(--ymh-surface,#fff); border:1rpx solid var(--ymh-paper-deep,#E9E0CC); border-radius:12rpx; box-shadow:var(--ymh-shadow-rest); padding:26rpx; display:flex; align-items:center; gap:20rpx; }
.ai-entry-icon { width:64rpx; height:64rpx; border-radius:8rpx; background:var(--ymh-slate-700,#43525F); color:#fff; font-size:24rpx; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.ai-entry-body { flex:1; min-width:0; }
.ai-entry-title { font-size:29rpx; font-weight:650; color:var(--ymh-ink,#1F1F1F); }
.ai-entry-sub { margin-top:4rpx; font-size:23rpx; color:var(--ymh-slate-600,#5B6B7A); }
.official-footer { margin-top:48rpx; text-align:center; font-size:22rpx; color:var(--ymh-text-3,#9B9B9B); line-height:1.7; }
.official-footer-sub { font-size:20rpx; }

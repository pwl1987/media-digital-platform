<view class="container">
  <view class="eyebrow">{{content.typeLabel}}</view>
  <view class="title">{{content.title}}</view>
  <view class="card intro"><view class="subtitle">{{content.summary}}</view></view>
  <view class="section-title">正文</view>
  <view class="card body">{{content.body}}</view>
  <button class="ai-btn" bindtap="askAI">问问 AI · 继续了解</button>
  <view class="section-title">相关内容</view>
  <view wx:for="{{content.relations}}" wx:key="title" class="card relation">
    <view class="relation-title">{{item.title}}</view><view class="muted">{{item.type}}</view>
  </view>
</view>

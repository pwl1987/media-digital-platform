/* 历史记忆：时间轴（EraAnchor 衬线大字 + 石材线 + 深红节点，V0.2 §6.6） */
.container { padding: 32rpx; padding-bottom: 56rpx; }

.page-title { font-size: 40rpx; font-weight: 700; color: var(--ymh-ink); font-family: "Songti SC", "STSong", serif; }
.page-sub { margin-top: 8rpx; font-size: 24rpx; color: var(--ymh-slate-600); }

.era-group { margin-top: 40rpx; }
.era-anchor { display: flex; align-items: center; gap: 20rpx; }
.era-line { flex: 1; height: 1rpx; background: var(--ymh-stone); }
.era-text { font-size: 34rpx; font-weight: 700; color: var(--ymh-slate-700); font-family: "Songti SC", "STSong", serif; letter-spacing: 2rpx; }

.event-card { margin-top: 24rpx; background: var(--ymh-surface); border: 1rpx solid var(--ymh-paper-deep); border-left: 6rpx solid var(--ymh-red-800); border-radius: 12rpx; box-shadow: var(--ymh-shadow-rest); padding: 28rpx; }
.event-card--open { box-shadow: var(--ymh-shadow-float); }
.event-date { font-size: 22rpx; color: var(--ymh-slate-600); font-variant-numeric: tabular-nums; }
.event-title { margin-top: 10rpx; font-size: 32rpx; font-weight: 650; color: var(--ymh-ink); }
.event-summary { margin-top: 12rpx; font-size: 25rpx; line-height: 1.6; color: var(--ymh-text-2); }
.event-foot { margin-top: 18rpx; display: flex; align-items: center; gap: 20rpx; }
.event-persons { flex: 1; font-size: 22rpx; color: var(--ymh-red-800); }
.event-count { font-size: 22rpx; color: var(--ymh-slate-600); }
.event-toggle { font-size: 22rpx; color: var(--ymh-slate-700); }

.event-body { margin-top: 20rpx; border-top: 1rpx solid var(--ymh-paper-deep); padding-top: 20rpx; }
.rel-empty { font-size: 24rpx; color: var(--ymh-text-3); text-align: center; padding: 16rpx 0; }
.mini-archive { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--ymh-paper-deep); }
.mini-type { font-size: 22rpx; color: var(--ymh-slate-700); background: var(--ymh-slate-100); border-radius: 4rpx; padding: 4rpx 12rpx; flex-shrink: 0; }
.mini-title { flex: 1; font-size: 25rpx; color: var(--ymh-text); line-height: 1.4; }
.mini-arrow { color: var(--ymh-text-3); font-size: 30rpx; }

.era-continue { margin-top: 48rpx; display: flex; align-items: center; gap: 20rpx; }
.era-text--today { color: var(--ymh-red-800); }
.to-stories { margin-top: 28rpx; text-align: center; font-size: 26rpx; color: var(--ymh-red-800); padding: 20rpx 0; }

.state { margin-top: 96rpx; text-align: center; color: var(--ymh-text-2); font-size: 26rpx; }
.retry-btn { margin: 24rpx auto 0; width: 200rpx; padding: 14rpx 0; border: 1rpx solid var(--ymh-slate-600); border-radius: 8rpx; color: var(--ymh-slate-700); font-size: 26rpx; }

<view class="container ai-page">
  <view class="ai-header">
    <view class="title">沂蒙精神智能助手</view>
    <view class="subtitle">从可靠资料出发，认识沂蒙精神与沂蒙文化。</view>
  </view>

  <view wx:if="{{messages.length === 0}}" class="card welcome-card">
    <view class="welcome-title">今天想了解什么？</view>
    <view class="subtitle">你可以直接提问，也可以选择下面的问题开始。</view>
    <view class="suggestions">
      <view wx:for="{{suggestedQuestions}}" wx:key="*this" class="suggestion" data-question="{{item}}" bindtap="askSuggested">{{item}}</view>
    </view>
  </view>

  <view wx:for="{{messages}}" wx:key="index" class="message {{item.role}}">
    <view wx:if="{{item.role === 'user'}}" class="bubble user-bubble">{{item.text}}</view>
    <view wx:else class="assistant-block">
      <view class="bubble assistant-bubble">{{item.answer}}</view>
      <view class="evidence-card">
        <view class="mini-title">参考来源</view>
        <view wx:for="{{item.sources}}" wx:key="id" class="source-row">{{item.type}} · {{item.title}}</view>
        <view class="mini-title evidence-title">证据</view>
        <view wx:for="{{item.evidence}}" wx:key="id" class="source-row">{{item.label}} · {{item.title}}</view>
      </view>
      <view class="related-card">
        <view class="mini-title">继续了解</view>
        <view wx:for="{{item.related}}" wx:key="id" class="related-row" data-type="{{item.type}}" data-id="{{item.id}}" bindtap="openRelated">{{item.title}} ›</view>
      </view>
      <button class="copy-btn" size="mini" data-text="{{item.answer}}" bindtap="copyAnswer">复制回答</button>
    </view>
  </view>

  <view class="composer">
    <input class="composer-input" value="{{input}}" placeholder="输入你想了解的问题" confirm-type="send" bindinput="onInput" bindconfirm="onSubmit" />
    <button class="send-btn" bindtap="ask">发送</button>
  </view>
</view>

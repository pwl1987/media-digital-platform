.ai-page { padding-bottom: 150rpx; }
.ai-header { margin-bottom: 24rpx; }
.welcome-card { margin-top: 20rpx; }
.welcome-title { font-size: 34rpx; font-weight: 700; }
.suggestions { margin-top: 24rpx; }
.suggestion { background: #f8f1f2; color: #7f1730; padding: 22rpx; border-radius: 16rpx; margin-top: 14rpx; font-size: 27rpx; line-height: 1.5; }
.message { display: flex; margin: 22rpx 0; }
.message.user { justify-content: flex-end; }
.bubble { max-width: 88%; padding: 22rpx 24rpx; border-radius: 20rpx; font-size: 28rpx; line-height: 1.7; box-sizing: border-box; }
.user-bubble { background: #9e1b32; color: #fff; border-bottom-right-radius: 6rpx; }
.assistant-bubble { background: #fff; color: #222; border-bottom-left-radius: 6rpx; }
.assistant-block { width: 100%; }
.evidence-card, .related-card { margin-top: 14rpx; background: #fff; border-radius: 16rpx; padding: 22rpx; }
.mini-title { color: #777; font-size: 24rpx; font-weight: 600; margin-bottom: 10rpx; }
.evidence-title { margin-top: 18rpx; }
.source-row, .related-row { padding: 12rpx 0; color: #333; font-size: 25rpx; border-top: 1px solid #f1f1f1; }
.related-row { color: #9e1b32; }
.copy-btn { margin: 16rpx 0 0; margin-left: 0; }
.composer { position: fixed; left: 0; right: 0; bottom: 0; padding: 18rpx 20rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.96); box-shadow: 0 -8rpx 30rpx rgba(0,0,0,.06); display: flex; gap: 14rpx; z-index: 10; }
.composer-input { flex: 1; background: #f5f5f5; border-radius: 999rpx; padding: 18rpx 24rpx; min-height: 72rpx; box-sizing: border-box; }
.send-btn { flex: 0 0 120rpx; margin: 0; background: #9e1b32; color: #fff; border-radius: 999rpx; font-size: 27rpx; line-height: 72rpx; height: 72rpx; padding: 0; }
.send-btn::after { border: 0; }

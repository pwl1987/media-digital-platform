<view class="container">
  <view class="search-bar">
    <input value="{{q}}" placeholder="搜索人物、故事、历史、地点" confirm-type="search" bindinput="onInput" bindconfirm="doSearch" />
    <button size="mini" bindtap="doSearch">搜索</button>
  </view>
  <view wx:if="{{results.length}}" class="result-list">
    <view wx:for="{{results}}" wx:key="id" class="card result-card" data-type="{{item.type}}" data-id="{{item.id}}" bindtap="openResult">
      <view class="result-tag">{{item.tag || item.type}}</view>
      <view class="result-title">{{item.title}}</view>
      <view class="result-summary">{{item.summary || '查看详细内容与关联资料'}}</view>
      <view class="result-arrow">›</view>
    </view>
  </view>
  <view wx:else class="card empty">没有找到相关内容</view>
</view>

.search-bar { display: flex; gap: 14rpx; background: #fff; padding: 14rpx; border-radius: 999rpx; box-shadow: 0 8rpx 24rpx rgba(0,0,0,.04); }
.search-bar input { flex: 1; padding: 8rpx 18rpx; min-width: 0; }
.search-bar button { margin: 0; color: #fff; background: #9E1B32; border-radius: 999rpx; }
.result-list { margin-top: 24rpx; }
.result-card { margin-bottom: 16rpx; position: relative; padding-right: 60rpx; }
.result-tag { display: inline-block; font-size: 22rpx; color: #9E1B32; background: #f8e9ed; border-radius: 8rpx; padding: 6rpx 12rpx; }
.result-title { margin-top: 12rpx; font-size: 30rpx; font-weight: 700; }
.result-summary { margin-top: 10rpx; color: #777; line-height: 1.55; font-size: 25rpx; }
.result-arrow { position: absolute; right: 24rpx; top: 50%; transform: translateY(-50%); color: #aaa; font-size: 42rpx; }
.empty { margin-top: 24rpx; text-align: center; color: #888; }

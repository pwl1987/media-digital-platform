<view class="container">
  <view class="card hero-small">
    <view class="eyebrow">我的沂蒙文化空间</view>
    <view class="title">欢迎回来</view>
    <view class="subtitle" style="color:#f7e9ed">游客模式也可以收藏和保留浏览记录</view>
  </view>

  <view class="stats grid-3">
    <view class="card stat"><view class="stat-number">{{favoriteCount}}</view><view class="muted">收藏</view></view>
    <view class="card stat"><view class="stat-number">{{historyCount}}</view><view class="muted">历史</view></view>
    <view class="card stat"><view class="stat-number">{{sessionCount}}</view><view class="muted">问答</view></view>
  </view>

  <view class="section-title">我的内容</view>
  <view class="card menu-row"><text>收藏内容</text><text class="muted">{{favoriteCount}} ›</text></view>
  <view class="card menu-row"><text>浏览历史</text><text class="muted">{{historyCount}} ›</text></view>
  <view class="card menu-row"><text>我的问答</text><text class="muted">{{sessionCount}} ›</text></view>

  <view class="section-title">平台</view>
  <view class="card menu-row"><text>隐私保护与用户协议</text><text class="muted">›</text></view>
  <view class="card menu-row" bindtap="clearLocalData"><text>清除本地记录</text><text class="muted">›</text></view>
  <view class="version muted">沂蒙精神智能平台 · Experience Plane V0.1</view>
</view>

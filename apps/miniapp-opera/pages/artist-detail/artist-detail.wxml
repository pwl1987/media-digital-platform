<view class="container" wx:if="{{artist}}">
  <!-- 演员头卡：黑白人像 + 红色名条 + 金色荣誉 -->
  <view class="portrait">
    <view class="portrait-glyph">{{glyph}}</view>
  </view>
  <view class="name-bar">
    <text class="name">{{artist.title}}</text>
    <text class="role">{{artist.role}}</text>
  </view>
  <view class="org">{{artist.organization}}</view>
  <view wx:if="{{artist.honors && artist.honors.length}}" class="honors">
    <text wx:for="{{artist.honors}}" wx:key="*this" class="honor">{{item}}</text>
  </view>

  <!-- 简介 -->
  <view class="section">
    <view class="section-title">个人简介</view>
    <view class="bio">{{artist.bio || '正式内容接入后展示。'}}</view>
  </view>

  <!-- 代表作品（走 API） -->
  <view class="section">
    <view class="section-title">代表作品</view>
    <view wx:if="{{worksLoading}}" class="skeleton-block"></view>
    <view wx:elif="{{works.length}}" class="works">
      <view wx:for="{{works}}" wx:key="id" class="work-row" data-id="{{item.id}}" bindtap="openWork">
        <view class="work-title">《{{item.title}}》</view>
        <view class="work-meta">{{item.tag}} · {{item.organization.title}}</view>
      </view>
    </view>
    <view wx:else class="empty">代表作品将在剧目 API 接入后展示</view>
  </view>

  <view class="actions">
    <view class="action-btn" bindtap="onShare">分享</view>
    <view class="action-btn action-btn--primary" bindtap="onFollow">+ 关注</view>
  </view>
</view>

<view wx:else class="state">
  <view class="state-emoji">🎭</view>
  <view class="state-title">演员档案未找到</view>
  <view class="retry-btn" bindtap="retry">重新加载</view>
</view>

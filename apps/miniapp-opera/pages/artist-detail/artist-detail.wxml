<view class="container" wx:if="{{artist}}">
  <view class="card hero">
    <view class="title">{{artist.title}}</view>
    <view class="subtitle">{{artist.role}} · {{artist.organization}}</view>
  </view>
  <view class="section-title">代表作品</view>
  <view wx:for="{{artist.workIds}}" wx:key="*this" class="card relation-card">作品 {{item}}</view>
</view>

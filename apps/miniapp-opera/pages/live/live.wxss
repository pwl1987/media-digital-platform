/* 现场直播：预告/回顾双态卡（红金宣纸 token） */
.container { min-height: 100vh; background: var(--ym-paper); padding: 34rpx 28rpx 60rpx; box-sizing: border-box; }
.page-head { padding: 4rpx 4rpx 8rpx; }
.eyebrow { font-size: 22rpx; letter-spacing: 3rpx; color: var(--ym-gold-700); font-weight: 700; }
.title { font-size: 46rpx; font-weight: 800; margin-top: 8rpx; color: var(--ym-ink); }
.subtitle { margin-top: 8rpx; font-size: 24rpx; color: var(--ym-text-2); line-height: 1.6; }

.section-label { margin-top: 32rpx; font-size: 30rpx; font-weight: 700; color: var(--ym-ink); padding-left: 16rpx; border-left: 6rpx solid var(--ym-red-700); font-family: "Noto Serif SC", "Songti SC", serif; }

.live-card { margin-top: 20rpx; background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-rest); padding: 28rpx; position: relative; overflow: hidden; }
.live-card--upcoming { border-left: 6rpx solid var(--ym-red-700); }
.live-card--ended { border-left: 6rpx solid var(--ym-line); }
.live-flag { display: inline-block; font-size: 20rpx; border-radius: 4rpx; padding: 4rpx 12rpx; }
.live-flag--ended { background: var(--ym-line); color: var(--ym-text-2); }
.live-card--upcoming .live-flag { background: var(--ym-red-700); color: #FFFFFF; }
.live-title { margin-top: 14rpx; font-size: 30rpx; font-weight: 650; color: var(--ym-ink); }
.live-sub { margin-top: 8rpx; font-size: 24rpx; color: var(--ym-text-2); }
.live-meta { margin-top: 10rpx; font-size: 22rpx; color: var(--ym-text-3); font-variant-numeric: tabular-nums; }

.official-footer { margin-top: 56rpx; text-align: center; font-size: 22rpx; color: var(--ym-text-3); }

/* 错误态：emoji + 主标 + 副标 + 重试（与详情页一致） */
.state { padding: 140rpx 0 0; text-align: center; }
.state-emoji { font-size: 88rpx; line-height: 1; }
.state-title { margin-top: 24rpx; font-size: 30rpx; color: var(--ym-ink); font-weight: 650; }
.state-sub { margin-top: 12rpx; font-size: 24rpx; color: var(--ym-text-3); padding: 0 80rpx; }
.retry-btn { margin: 32rpx auto 0; width: 220rpx; padding: 16rpx 0; border: 1rpx solid var(--ym-red-700); border-radius: 8rpx; color: var(--ym-red-700); font-size: 26rpx; }

/* 加载骨架（避免白屏） */
.sk-list { padding-top: 20rpx; }
.sk-card { padding: 30rpx; margin-bottom: 20rpx; }
.sk-line { height: 22rpx; border-radius: 4rpx; background: var(--ym-paper-deep, var(--ym-paper-deep)); margin-top: 18rpx; animation: sk-pulse 1.4s ease-in-out infinite; }
.sk-line--lg { height: 34rpx; width: 70%; }
@keyframes sk-pulse { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; } }

/* 空态 */
.empty-state { padding: 140rpx 0 0; text-align: center; }
.empty-emoji { font-size: 88rpx; line-height: 1; }
.empty-title { margin-top: 24rpx; font-size: 30rpx; color: var(--ym-ink); font-weight: 650; }
.empty-sub { margin-top: 12rpx; font-size: 24rpx; color: var(--ym-text-3); padding: 0 80rpx; }

/* 首页：沉浸式轮播 + 悬浮快捷入口 + 新闻优先（OPERA_UI_VISUAL_BASELINE_V0.1 §7，交互模式参考成熟实践） */

.container { padding: 0 0 60rpx; }

/* 轮播（首页自定义导航，顶部沉浸式） */
.carousel-wrapper { position: relative; }
.carousel { width: 100%; height: 560rpx; }
.slide { position: relative; width: 100%; height: 560rpx; }
.slide-img { width: 100%; height: 100%; }
.slide-poster { height: 100%; padding-top: 120rpx; box-sizing: border-box; background: linear-gradient(150deg, var(--ym-red-900), var(--ym-red-700)); display: flex; flex-direction: column; align-items: center; justify-content: center; color: #FFFFFF; }
.slide-kicker { font-size: 24rpx; letter-spacing: 6rpx; opacity: 0.85; }
.slide-title { margin-top: 18rpx; font-size: 52rpx; font-weight: 700; letter-spacing: 4rpx; }
.slide-sub { margin-top: 16rpx; font-size: 24rpx; opacity: 0.85; padding: 0 60rpx; text-align: center; line-height: 1.5; }
.slide-badge { position: absolute; top: 128rpx; left: 28rpx; background: rgba(31,31,31,0.4); color: #FFFFFF; font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 4rpx; }

.indicators { position: absolute; right: 28rpx; bottom: 20rpx; display: flex; gap: 10rpx; }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: rgba(255,255,255,0.45); }
.dot--on { background: var(--ym-gold-300); width: 28rpx; border-radius: 6rpx; }

/* 悬浮快捷入口卡 */
.quick-card { margin: -36rpx 28rpx 0; position: relative; background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-float); padding: 24rpx 0; display: flex; }
.quick-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.quick-icon { width: 76rpx; height: 76rpx; border-radius: 12rpx; background: var(--ym-red-50); color: var(--ym-red-700); font-size: 30rpx; display: flex; align-items: center; justify-content: center; font-family: "Noto Serif SC", "Songti SC", serif; }
.quick-text { font-size: 24rpx; color: var(--ym-text); }

.section { margin-top: 44rpx; padding: 0 28rpx; }
.section-head { display: flex; align-items: center; }
.section-bar { width: 6rpx; height: 32rpx; background: var(--ym-red-700); border-radius: 2rpx; margin-right: 14rpx; }
.section-title { flex: 1; font-size: 34rpx; font-weight: 700; color: var(--ym-ink); font-family: "Noto Serif SC", "Songti SC", "STSong", serif; }
.more { color: var(--ym-red-700); font-size: 24rpx; }

/* 四色功能瓦片（设计稿配色：陶土棕/革命红/暖橙/长空蓝） */
.tile-grid { margin: -36rpx 28rpx 0; position: relative; display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; }
.tile { border-radius: 12rpx; padding: 26rpx 28rpx; color: #FFFFFF; box-shadow: var(--ym-shadow-float); }
.tile--tan { background: linear-gradient(140deg, #A96F35, #BC7E42); }
.tile--red { background: linear-gradient(140deg, #A82F1E, #CB3925); }
.tile--orange { background: linear-gradient(140deg, #B25D3C, #CA6E4B); }
.tile--blue { background: linear-gradient(140deg, #48657A, #57788C); }
.tile-label { font-size: 30rpx; font-weight: 700; }
.tile-sub { margin-top: 8rpx; font-size: 20rpx; opacity: 0.85; }

/* 热门榜单 */
.rank-card { margin-top: 24rpx; background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-rest); padding: 10rpx 26rpx; }
.rank-row { display: flex; align-items: center; gap: 18rpx; padding: 22rpx 0; border-bottom: 1rpx solid var(--ym-paper); }
.rank-row:last-child { border-bottom: 0; }
.rank-no { width: 44rpx; height: 44rpx; border-radius: 8rpx; display: flex; align-items: center; justify-content: center; font-size: 26rpx; font-weight: 700; font-variant-numeric: tabular-nums; flex-shrink: 0; font-family: "Noto Serif SC", "Songti SC", serif; }
.rank-no--hot { background: var(--ym-red-700); color: #FFFFFF; }
.rank-no--normal { background: var(--ym-red-50); color: var(--ym-red-700); }
.rank-title { flex: 1; min-width: 0; font-size: 28rpx; font-weight: 600; color: var(--ym-ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rank-views { font-size: 22rpx; color: var(--ym-text-3); font-variant-numeric: tabular-nums; flex-shrink: 0; }
.rank-play { color: var(--ym-red-700); font-size: 22rpx; flex-shrink: 0; }

/* 头条大卡 */
.headline { position: relative; margin-top: 24rpx; background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-rest); overflow: hidden; }
.headline-cover { height: 300rpx; background: linear-gradient(140deg, var(--ym-red-900), var(--ym-red-500)); position: relative; }
.headline-img { width: 100%; height: 100%; }
.headline-badge { position: absolute; top: 20rpx; left: 20rpx; background: var(--ym-red-700); color: #FFFFFF; font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 4rpx; }
.headline-body { padding: 28rpx; }
.headline-title { font-size: 38rpx; font-weight: 700; line-height: 1.35; color: var(--ym-ink); font-family: "Noto Serif SC", "Songti SC", serif; }
.headline-summary { margin-top: 14rpx; font-size: 26rpx; color: var(--ym-text-2); line-height: 1.6; }
.gold-line { height: 4rpx; background: linear-gradient(90deg, var(--ym-gold-500), var(--ym-gold-300)); }

.source-meta { margin-top: 10rpx; font-size: 24rpx; color: var(--ym-text-3); font-variant-numeric: tabular-nums; }

.news-row { margin-top: 20rpx; background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-rest); padding: 26rpx; display: flex; align-items: center; gap: 16rpx; }
.news-text { flex: 1; min-width: 0; }
.news-title { font-size: 30rpx; font-weight: 650; color: var(--ym-ink); line-height: 1.45; }
.badge-plain { font-size: 22rpx; color: var(--ym-text-2); border: 1rpx solid var(--ym-line); border-radius: 4rpx; padding: 4rpx 12rpx; flex-shrink: 0; }

/* 直播预告卡 */
.live-card { margin-top: 24rpx; background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-rest); overflow: hidden; display: flex; }
.live-poster { width: 240rpx; min-height: 200rpx; background: linear-gradient(150deg, var(--ym-red-900), var(--ym-red-500)); position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
.live-badge { position: absolute; top: 14rpx; left: 14rpx; background: var(--ym-red-700); color: #FFFFFF; font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 4rpx; }
.live-poster-title { color: #FFFFFF; font-size: 28rpx; text-align: center; padding: 0 16rpx; line-height: 1.4; }
.live-body { flex: 1; padding: 24rpx; }
.live-time { font-size: 26rpx; font-weight: 650; color: var(--ym-ink); font-variant-numeric: tabular-nums; }
.live-place { margin-top: 8rpx; font-size: 24rpx; color: var(--ym-text-2); }
.live-countdown { margin-top: 14rpx; display: inline-block; font-size: 22rpx; color: var(--ym-red-700); background: var(--ym-red-50); border: 1rpx solid var(--ym-red-100); border-radius: 4rpx; padding: 6rpx 14rpx; font-variant-numeric: tabular-nums; }

/* 精品剧目海报卡（2 列） */
.opera-grid { margin-top: 24rpx; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20rpx; }
.opera-card { background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-rest); overflow: hidden; }
.opera-poster { height: 260rpx; background: linear-gradient(160deg, var(--ym-paper), var(--ym-gold-100)); position: relative; display: flex; align-items: center; justify-content: center; }
.opera-poster-img { width: 100%; height: 100%; }
.opera-poster-fallback { font-size: 38rpx; color: var(--ym-red-700); }
.opera-tag { position: absolute; top: 14rpx; left: 14rpx; font-size: 20rpx; color: var(--ym-gold-700); background: var(--ym-gold-100); border-radius: 4rpx; padding: 4rpx 12rpx; }
.opera-title { padding: 16rpx 18rpx 0; font-size: 27rpx; font-weight: 650; color: var(--ym-ink); }
.opera-org { padding: 6rpx 18rpx 16rpx; font-size: 22rpx; color: var(--ym-text-3); }

/* 视频墙 */
.h-scroll { margin-top: 24rpx; white-space: nowrap; }
.video-wall { margin-top: 24rpx; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20rpx; }
.media-card { background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-rest); overflow: hidden; }
.media-cover { height: 190rpx; background: linear-gradient(150deg, var(--ym-red-900), var(--ym-red-700)); position: relative; overflow: hidden; }
.media-cover-img { width: 100%; height: 100%; }
.media-cat { position: absolute; top: 14rpx; left: 14rpx; font-size: 20rpx; color: #FFFFFF; background: rgba(31,31,31,0.35); border-radius: 4rpx; padding: 4rpx 10rpx; }
.media-duration { position: absolute; right: 14rpx; bottom: 14rpx; font-size: 20rpx; color: #FFFFFF; background: rgba(31,31,31,0.55); border-radius: 4rpx; padding: 4rpx 10rpx; font-variant-numeric: tabular-nums; }
.media-title { padding: 16rpx 18rpx 4rpx; font-size: 26rpx; font-weight: 650; color: var(--ym-ink); line-height: 1.4; white-space: normal; }
.media-card .source-meta { padding: 0 18rpx 16rpx; margin-top: 4rpx; font-size: 22rpx; }
.media-tags { padding: 8rpx 18rpx 0; display: flex; flex-wrap: wrap; gap: 8rpx; }
.media-tag { font-size: 20rpx; color: var(--ym-red-700); background: var(--ym-red-50); border-radius: 4rpx; padding: 2rpx 10rpx; }

/* 展演活动 */
.event-row { margin-top: 20rpx; background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-rest); padding: 26rpx; display: flex; align-items: center; gap: 18rpx; }
.event-status { flex-shrink: 0; font-size: 22rpx; border-radius: 4rpx; padding: 6rpx 14rpx; }
.event-status--upcoming { background: var(--ym-gold-100); color: var(--ym-gold-700); }
.event-status--ongoing { background: var(--ym-red-700); color: #FFFFFF; }
.event-status--ended { background: var(--ym-line); color: var(--ym-text-2); }
.event-text { flex: 1; min-width: 0; }
.event-title { font-size: 28rpx; font-weight: 650; color: var(--ym-ink); }

/* 文化专题 */
.topic-banner { display: inline-block; width: 420rpx; margin-right: 20rpx; vertical-align: top; background: linear-gradient(140deg, var(--ym-paper), var(--ym-gold-100)); border: 1rpx solid var(--ym-gold-300); border-radius: 12rpx; padding: 32rpx; box-sizing: border-box; white-space: normal; }
.topic-title { font-size: 34rpx; font-weight: 700; color: var(--ym-red-700); }
.topic-sub { margin-top: 10rpx; font-size: 24rpx; color: var(--ym-text-2); }
.topic-enter { margin-top: 20rpx; font-size: 24rpx; color: var(--ym-gold-700); }

.official-footer { margin-top: 56rpx; text-align: center; font-size: 22rpx; color: var(--ym-text-3); line-height: 1.7; }
.official-footer-sub { font-size: 20rpx; }

.state { padding-top: 120rpx; text-align: center; color: var(--ym-text-2); font-size: 26rpx; }
.state-emoji { font-size: 88rpx; line-height: 1; }
.state-title { margin-top: 20rpx; font-size: 32rpx; color: var(--ym-ink); font-weight: 650; }
.state-sub { margin-top: 12rpx; font-size: 24rpx; color: var(--ym-text-3); padding: 0 80rpx; line-height: 1.6; }
.retry-btn { margin: 32rpx auto 0; width: 220rpx; padding: 16rpx 0; border: 1rpx solid var(--ym-red-700); border-radius: 8rpx; color: var(--ym-red-700); font-size: 26rpx; }

/* 骨架屏 */
@keyframes sk-pulse { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; } }
.sk-banner { width: 100%; height: 560rpx; background: linear-gradient(180deg, var(--ym-red-100), var(--ym-paper)); animation: sk-pulse 1.4s ease-in-out infinite; }
.sk-tiles { margin: -36rpx 28rpx 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; }
.sk-tile { height: 100rpx; border-radius: 12rpx; background: var(--ym-paper-deep, var(--ym-paper-deep)); animation: sk-pulse 1.4s ease-in-out infinite; }
.sk-headline { margin: 36rpx 28rpx 0; padding: 28rpx; background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-rest); }
.sk-cover { height: 220rpx; border-radius: 8rpx; background: var(--ym-paper-deep, var(--ym-paper-deep)); animation: sk-pulse 1.4s ease-in-out infinite; }
.sk-line { height: 22rpx; border-radius: 4rpx; background: var(--ym-paper-deep, var(--ym-paper-deep)); margin-top: 18rpx; animation: sk-pulse 1.4s ease-in-out infinite; }
.sk-line--title { height: 30rpx; }
.sk-line--short { width: 60%; }

/* 顶部搜索入口（小程序全站搜索的唯一入口） */
.search-entry { display: flex; align-items: center; gap: 14rpx; margin: 24rpx 28rpx 0; padding: 0 28rpx; height: 76rpx; background: var(--ym-surface); border-radius: 40rpx; box-shadow: var(--ym-shadow-rest); border: 1rpx solid var(--ym-line); }
.search-entry-icon { font-size: 32rpx; color: var(--ym-text-3); flex-shrink: 0; }
.search-entry-text { font-size: 26rpx; color: var(--ym-text-3); flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

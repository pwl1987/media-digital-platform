/* 首页：现代中国文化门户（OPERA_UI_VISUAL_BASELINE_V0.1 §7） */

.hero { background: linear-gradient(150deg, var(--ym-red-900), var(--ym-red-700)); color: #FFFFFF; border-radius: 12rpx; padding: 44rpx 36rpx; }
.hero-eyebrow { font-size: 24rpx; opacity: 0.85; letter-spacing: 4rpx; }
.hero-title { margin-top: 16rpx; font-size: 56rpx; font-weight: 700; letter-spacing: 4rpx; }
.hero-sub { margin-top: 16rpx; font-size: 24rpx; opacity: 0.9; line-height: 1.6; }

.section { margin-top: 48rpx; }
.section-head { display: flex; align-items: center; }
.section-bar { width: 6rpx; height: 32rpx; background: var(--ym-red-700); border-radius: 2rpx; margin-right: 14rpx; }
.section-title { flex: 1; font-size: 34rpx; font-weight: 700; color: var(--ym-ink); font-family: "Noto Serif SC", "Songti SC", "STSong", serif; }
.more { color: var(--ym-red-700); font-size: 24rpx; }

/* 头条大卡 */
.headline { position: relative; margin-top: 24rpx; background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-rest); overflow: hidden; }
.headline-cover { height: 320rpx; background: linear-gradient(140deg, var(--ym-red-900), var(--ym-red-500)); position: relative; }
.headline-badge { position: absolute; top: 20rpx; left: 20rpx; background: var(--ym-red-700); color: #FFFFFF; font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 4rpx; }
.headline-body { padding: 28rpx; }
.headline-title { font-size: 40rpx; font-weight: 700; line-height: 1.35; color: var(--ym-ink); font-family: "Noto Serif SC", "Songti SC", "STSong", serif; }
.headline-summary { margin-top: 14rpx; font-size: 26rpx; color: var(--ym-text-2); line-height: 1.6; }
.headline-gold-line { height: 4rpx; background: linear-gradient(90deg, var(--ym-gold-500), var(--ym-gold-300)); }

.source-meta { margin-top: 10rpx; font-size: 24rpx; color: var(--ym-text-3); font-variant-numeric: tabular-nums; }

.news-row { margin-top: 20rpx; background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-rest); padding: 26rpx; display: flex; align-items: center; gap: 16rpx; }
.news-text { flex: 1; min-width: 0; }
.news-title { font-size: 30rpx; font-weight: 650; color: var(--ym-ink); line-height: 1.45; }
.badge-plain { font-size: 22rpx; color: var(--ym-text-2); border: 1rpx solid var(--ym-line); border-radius: 4rpx; padding: 4rpx 12rpx; flex-shrink: 0; }

/* 精品剧目横滑 */
.h-scroll { margin-top: 24rpx; white-space: nowrap; }
.work-card { display: inline-block; width: 260rpx; margin-right: 20rpx; vertical-align: top; }
.work-poster { height: 340rpx; border-radius: 12rpx 12rpx 0 0; background: linear-gradient(160deg, var(--ym-paper), var(--ym-gold-100)); display: flex; align-items: center; justify-content: center; }
.work-poster-title { font-size: 44rpx; color: var(--ym-red-700); }
.work-tag { display: inline-block; margin-top: 12rpx; font-size: 22rpx; color: var(--ym-gold-700); background: var(--ym-gold-100); border-radius: 4rpx; padding: 4rpx 12rpx; }
.work-title { margin-top: 10rpx; font-size: 28rpx; font-weight: 650; color: var(--ym-ink); }
.work-org { margin-top: 4rpx; font-size: 22rpx; color: var(--ym-text-3); }

/* 视频墙 2 列（MediaCard：封面/时长/标题/来源/清晰度） */
.video-wall { margin-top: 24rpx; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20rpx; }
.media-card { background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-rest); overflow: hidden; }
.media-cover { height: 190rpx; background: linear-gradient(150deg, var(--ym-red-900), var(--ym-red-700)); position: relative; }
.media-cat { position: absolute; top: 14rpx; left: 14rpx; font-size: 20rpx; color: #FFFFFF; background: rgba(31,31,31,0.35); border-radius: 4rpx; padding: 4rpx 10rpx; }
.media-duration { position: absolute; right: 14rpx; bottom: 14rpx; font-size: 20rpx; color: #FFFFFF; background: rgba(31,31,31,0.55); border-radius: 4rpx; padding: 4rpx 10rpx; font-variant-numeric: tabular-nums; }
.media-title { padding: 16rpx 18rpx 4rpx; font-size: 26rpx; font-weight: 650; color: var(--ym-ink); line-height: 1.4; white-space: normal; }
.media-card .source-meta { padding: 0 18rpx 16rpx; margin-top: 4rpx; font-size: 22rpx; }

/* 展演活动 */
.event-row { margin-top: 20rpx; background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-rest); padding: 26rpx; display: flex; align-items: center; gap: 18rpx; }
.event-status { flex-shrink: 0; font-size: 22rpx; border-radius: 4rpx; padding: 6rpx 14rpx; }
.event-status--upcoming { background: var(--ym-gold-100); color: var(--ym-gold-700); }
.event-status--ongoing { background: var(--ym-red-700); color: #FFFFFF; }
.event-status--ended { background: var(--ym-line); color: var(--ym-text-2); }
.event-text { flex: 1; min-width: 0; }
.event-title { font-size: 28rpx; font-weight: 650; color: var(--ym-ink); }

/* 文化专题 TopicBanner */
.topic-banner { display: inline-block; width: 420rpx; margin-right: 20rpx; vertical-align: top; background: linear-gradient(140deg, var(--ym-paper), var(--ym-gold-100)); border: 1rpx solid var(--ym-gold-300); border-radius: 12rpx; padding: 32rpx; box-sizing: border-box; white-space: normal; }
.topic-title { font-size: 34rpx; font-weight: 700; color: var(--ym-red-700); }
.topic-sub { margin-top: 10rpx; font-size: 24rpx; color: var(--ym-text-2); }
.topic-enter { margin-top: 20rpx; font-size: 24rpx; color: var(--ym-gold-700); }

.official-footer { margin-top: 56rpx; text-align: center; font-size: 22rpx; color: var(--ym-text-3); line-height: 1.7; }
.official-footer-sub { font-size: 20rpx; }

.state { margin-top: 96rpx; text-align: center; color: var(--ym-text-2); font-size: 26rpx; }
.retry-btn { margin: 24rpx auto 0; width: 200rpx; padding: 14rpx 0; border: 1rpx solid var(--ym-red-700); border-radius: 8rpx; color: var(--ym-red-700); font-size: 26rpx; }

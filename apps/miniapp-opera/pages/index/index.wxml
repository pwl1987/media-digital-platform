<view class="container">
  <view class="card hero">
    <view class="eyebrow">沂蒙小戏小剧 · 数字宣传平台</view>
    <view class="title">好戏上演，精彩沂蒙</view>
    <view class="subtitle" style="color:#F2E4E0">聚焦优秀小戏小剧作品、演出动态与舞台影像，让更多人看见沂蒙文艺。</view>
    <view class="hero-action" bindtap="goEvents">查看近期展演 ›</view>
  </view>

  <view class="search-entry" bindtap="goWorks">搜索剧目、演员、剧团、活动 <text>⌕</text></view>

  <view class="section-title">精彩推荐</view>
  <view class="promo-grid">
    <view class="promo-card promo-primary" bindtap="goWorks">
      <view class="promo-kicker">精品剧目</view>
      <view class="promo-title">精选好戏</view>
      <view class="promo-desc">认识优秀作品与创作团队</view>
    </view>
    <view class="promo-card promo-secondary" bindtap="goEvents">
      <view class="promo-kicker">展演资讯</view>
      <view class="promo-title">近期演出</view>
      <view class="promo-desc">掌握时间、地点与活动动态</view>
    </view>
  </view>

  <view class="section-title">精品剧目 <text class="more" bindtap="goWorks">更多 ›</text></view>
  <view wx:for="{{works}}" wx:key="id" class="card content-card" data-id="{{item.id}}" bindtap="openWork">
    <view class="poster-mini">舞台<br/>影像</view>
    <view class="content-main">
      <view class="content-tag">{{item.tag}}</view>
      <view class="content-title">{{item.title}}</view>
      <view class="content-meta">{{item.organization.title}} · {{item.artists[0].title}}</view>
    </view>
    <view class="content-arrow">›</view>
  </view>

  <view class="section-title">近期展演 <text class="more" bindtap="goEvents">全部 ›</text></view>
  <view wx:for="{{events}}" wx:key="id" class="card event-card" data-id="{{item.id}}" bindtap="openEvent">
    <view class="event-date">{{item.monthDay}}</view>
    <view class="event-main">
      <view class="content-tag">{{item.statusLabel}}</view>
      <view class="content-title">{{item.title}}</view>
      <view class="content-meta">{{item.place}} · {{item.timeLabel}}</view>
    </view>
  </view>

  <view class="section-title">关于小戏小剧</view>
  <view class="card culture-intro">
    <view class="culture-title">记录舞台 · 传播精彩 · 留住记忆</view>
    <view class="subtitle">以作品、演员、剧团和演出为线索，持续汇聚沂蒙小戏小剧文化内容。</view>
  </view>
</view>

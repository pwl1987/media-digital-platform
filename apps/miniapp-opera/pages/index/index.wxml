<view class="container">
  <view wx:if="{{loading}}" class="state">正在加载官方平台…</view>
  <view wx:elif="{{error}}" class="state">
    <view>内容加载失败</view>
    <view class="retry-btn" bindtap="retry">重新加载</view>
  </view>

  <block wx:else>
    <!-- 沉浸式轮播：宣传位（新闻头条/精品剧目/专题），支持 coverUrl，无图走红金渐变海报位 -->
    <view class="carousel-wrapper">
      <swiper
        class="carousel"
        indicator-dots="{{false}}"
        autoplay="{{carousel.autoplay}}"
        interval="{{carousel.interval}}"
        duration="{{carousel.duration}}"
        circular="{{true}}"
        current="{{carousel.current}}"
        bindchange="onSwiperChange"
      >
        <swiper-item wx:for="{{slides}}" wx:key="id">
          <view class="slide" data-type="{{item.type}}" data-id="{{item.targetId}}" bindtap="onSlideTap">
            <image wx:if="{{item.coverUrl}}" class="slide-img" src="{{item.coverUrl}}" mode="aspectFill" />
            <view wx:else class="slide-poster">
              <view class="slide-kicker">{{item.kicker}}</view>
              <view class="slide-title serif">{{item.title}}</view>
              <view class="slide-sub">{{item.sub}}</view>
            </view>
            <view class="slide-badge">{{item.kicker}}</view>
          </view>
        </swiper-item>
      </swiper>
      <view class="indicators">
        <view
          wx:for="{{slides}}"
          wx:key="id"
          class="dot {{carousel.current === index ? 'dot--on' : ''}}"
        ></view>
      </view>
    </view>

    <!-- 四色功能瓦片（剧目展演/直播观看/互动参与/文化传承） -->
    <view class="tile-grid">
      <view
        wx:for="{{quickTiles}}"
        wx:key="id"
        class="tile tile--{{item.color}}"
        data-target="{{item.target}}"
        bindtap="openTile"
      >
        <view class="tile-label">{{item.label}}</view>
        <view class="tile-sub">{{item.sub}}</view>
      </view>
    </view>

    <!-- 最新动态（权重 ≥60%） -->
    <view class="section">
      <view class="section-head"><view class="section-bar"></view><view class="section-title">最新动态</view><view class="more" bindtap="goNews">更多 ›</view></view>
      <view wx:if="{{headline}}" class="headline" data-id="{{headline.id}}" bindtap="openNews">
        <view class="headline-cover">
          <image wx:if="{{headline.coverUrl}}" class="headline-img" src="{{headline.coverUrl}}" mode="aspectFill" />
          <view class="headline-badge">{{headline.sourceLevelLabel}}</view>
        </view>
        <view class="headline-body">
          <view class="headline-title">{{headline.title}}</view>
          <view class="headline-summary">{{headline.summary}}</view>
          <view class="source-meta">来源：{{headline.sourceName}} · {{headline.date}}</view>
        </view>
        <view class="gold-line"></view>
      </view>
      <view wx:for="{{newsList}}" wx:key="id" class="news-row" data-id="{{item.id}}" bindtap="openNews">
        <view class="news-text">
          <view class="news-title">{{item.title}}</view>
          <view class="source-meta">来源：{{item.sourceName}} · {{item.date}}</view>
        </view>
        <view wx:if="{{item.sourceLevelLabel !== '官方发布'}}" class="badge-plain">{{item.sourceLevelLabel}}</view>
      </view>
    </view>

    <!-- 直播预告 -->
    <view class="section" wx:if="{{liveCard}}">
      <view class="section-head"><view class="section-bar"></view><view class="section-title">直播预告</view><view class="more" bindtap="goLive">更多 ›</view></view>
      <view class="live-card" bindtap="goLive">
        <view class="live-poster">
          <view class="live-badge">直播预告</view>
          <view class="live-poster-title serif">{{liveCard.title}}</view>
        </view>
        <view class="live-body">
          <view class="live-time">{{liveCard.startAt}}</view>
          <view class="live-place">{{liveCard.place}}</view>
          <view wx:if="{{countdown}}" class="live-countdown">{{countdown}}</view>
        </view>
      </view>
    </view>

    <!-- 热门榜单（按播放量） -->
    <view class="section" wx:if="{{ranking.length}}">
      <view class="section-head"><view class="section-bar"></view><view class="section-title">热门榜单</view><view class="more" bindtap="goVideos">更多 ›</view></view>
      <view class="rank-card">
        <view wx:for="{{ranking}}" wx:key="id" class="rank-row" data-id="{{item.id}}" bindtap="openRank">
          <view class="rank-no rank-no--{{item.rank <= 3 ? 'hot' : 'normal'}}">{{item.rank}}</view>
          <view class="rank-title">{{item.title}}</view>
          <view class="rank-views">{{item.viewsLabel}} 播放</view>
          <view class="rank-play">▶</view>
        </view>
      </view>
    </view>

    <!-- 精品剧目（海报卡） -->
    <view class="section">
      <view class="section-head"><view class="section-bar"></view><view class="section-title">精品剧目</view><view class="more" bindtap="goWorks">更多 ›</view></view>
      <view class="opera-grid">
        <view wx:for="{{works}}" wx:key="id" class="opera-card" data-id="{{item.id}}" bindtap="openWork">
          <view class="opera-poster">
            <image wx:if="{{item.posterUrl}}" class="opera-poster-img" src="{{item.posterUrl}}" mode="aspectFill" />
            <view wx:else class="opera-poster-fallback serif">{{item.title}}</view>
            <view class="opera-tag">{{item.tag}}</view>
          </view>
          <view class="opera-title">《{{item.title}}》</view>
          <view class="opera-org">{{item.organization.title}}</view>
        </view>
      </view>
    </view>

    <!-- 精彩影像（视频墙 2 列） -->
    <view class="section">
      <view class="section-head"><view class="section-bar"></view><view class="section-title">精彩影像</view><view class="more" bindtap="goVideos">更多 ›</view></view>
      <view class="video-wall">
        <view wx:for="{{videos}}" wx:key="id" class="media-card" data-id="{{item.id}}" bindtap="openVideo">
          <view class="media-cover">
            <image wx:if="{{item.coverUrl}}" class="media-cover-img" src="{{item.coverUrl}}" mode="aspectFill" />
            <view class="media-cat">{{item.category}}</view>
            <view class="media-duration">{{item.durationLabel}}</view>
          </view>
          <view class="media-title">{{item.title}}</view>
          <view wx:if="{{item.tags.length}}" class="media-tags">
            <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="media-tag">{{tag}}</text>
          </view>
          <view class="source-meta">{{item.sourceName}} · {{item.resolution}}</view>
        </view>
      </view>
    </view>

    <!-- 展演活动 -->
    <view class="section">
      <view class="section-head"><view class="section-bar"></view><view class="section-title">展演活动</view><view class="more" bindtap="goEvents">更多 ›</view></view>
      <view wx:for="{{events}}" wx:key="id" class="event-row" data-id="{{item.id}}" bindtap="openEvent">
        <view class="event-status event-status--{{item.lifecycleStatus}}">{{item.lifecycleStatus === 'upcoming' ? '预告' : item.lifecycleStatus === 'ongoing' ? '进行中' : '已结束'}}</view>
        <view class="event-text">
          <view class="event-title">{{item.title}}</view>
          <view class="source-meta">{{item.startAt}} · {{item.place}}</view>
        </view>
      </view>
    </view>

    <!-- 文化专题 -->
    <view class="section">
      <view class="section-head"><view class="section-bar"></view><view class="section-title">文化专题</view></view>
      <scroll-view scroll-x class="h-scroll">
        <view wx:for="{{topics}}" wx:key="id" class="topic-banner" data-category="{{item.category}}" bindtap="openTopic">
          <view class="topic-title serif">{{item.title}}</view>
          <view class="topic-sub">{{item.sub}}</view>
          <view class="topic-enter">进入专题 ›</view>
        </view>
      </scroll-view>
    </view>

    <view class="official-footer">
      <view>沂蒙小戏小剧官方数字传播平台</view>
      <view class="official-footer-sub">主管单位：沂蒙小戏小剧官方平台建设工作组</view>
    </view>
  </block>
</view>

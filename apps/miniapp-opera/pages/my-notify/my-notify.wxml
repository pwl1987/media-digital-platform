<view class="page">
  <view wx:if="{{loading}}" class="sk-list">
    <view wx:for="{{[1,2]}}" wx:key="*this" class="sk-card">
      <view class="sk-line sk-line--lg"></view>
      <view class="sk-line"></view>
    </view>
  </view>

  <block wx:else>
    <view wx:if="{{!upcomingCount && !liveCount && !endedCount}}" class="empty-state">
      <view class="empty-emoji">◷</view>
      <view class="empty-title">暂无直播提醒</view>
      <view class="empty-sub">在直播预告详情页底部操作条点击"到时提醒"后会出现在这里</view>
    </view>

    <view wx:if="{{upcomingCount}}" class="section">
      <view class="section-title">即将开播 · {{upcomingCount}}</view>
      <view wx:for="{{upcoming}}" wx:key="id" class="card live-card live-card--upcoming" data-id="{{item.id}}" bindtap="openLive">
        <view class="live-flag">直播预告</view>
        <view class="live-title">{{item.title}}</view>
        <view class="live-meta">{{item.startAt}} · {{item.place}}</view>
        <view class="result-actions" data-id="{{item.id}}" catchtap="cancel">
          <view class="unfav-btn">取消提醒</view>
        </view>
      </view>
    </view>

    <view wx:if="{{liveCount}}" class="section">
      <view class="section-title">正在进行 · {{liveCount}}</view>
      <view wx:for="{{live}}" wx:key="id" class="card live-card live-card--upcoming" data-id="{{item.id}}" bindtap="openLive">
        <view class="live-flag" style="background:var(--ym-red-700)">直播中</view>
        <view class="live-title">{{item.title}}</view>
        <view class="live-meta">{{item.startAt}} · {{item.place}}</view>
      </view>
    </view>

    <view wx:if="{{endedCount}}" class="section">
      <view class="section-title">历史直播 · {{endedCount}}</view>
      <view wx:for="{{ended}}" wx:key="id" class="card live-card live-card--ended" data-id="{{item.id}}" bindtap="openLive">
        <view class="live-flag live-flag--ended">已结束</view>
        <view class="live-title">{{item.title}}</view>
        <view class="live-meta">{{item.startAt}} · {{item.place}}</view>
      </view>
    </view>
  </block>
</view>
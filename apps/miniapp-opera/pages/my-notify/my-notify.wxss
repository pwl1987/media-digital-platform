/* 直播提醒：红金宣纸 token */
.page { min-height: 100vh; background: var(--ym-paper); padding: 28rpx 28rpx 40rpx; }
.section { margin-bottom: 24rpx; }
.section-title { font-size: 28rpx; font-weight: 700; color: var(--ym-ink); padding-left: 14rpx; border-left: 6rpx solid var(--ym-red-700); margin-bottom: 18rpx; font-family: "Noto Serif SC", "Songti SC", serif; }

.live-card { position: relative; padding: 30rpx 28rpx; margin-bottom: 16rpx; }
.live-card--upcoming { background: linear-gradient(160deg, var(--ym-surface), var(--ym-gold-50)); }
.live-card--ended { background: var(--ym-surface); opacity: 0.88; }
.live-flag { display: inline-block; font-size: 22rpx; color: var(--ym-gold-700); background: var(--ym-gold-100); border-radius: 4rpx; padding: 4rpx 12rpx; margin-bottom: 12rpx; }
.live-flag--ended { background: var(--ym-paper-deep, var(--ym-paper-deep)); color: var(--ym-text-3); }
.live-title { font-size: 30rpx; font-weight: 650; color: var(--ym-ink); line-height: 1.4; }
.live-meta { margin-top: 10rpx; font-size: 22rpx; color: var(--ym-text-3); font-variant-numeric: tabular-nums; }
.result-actions { margin-top: 18rpx; display: flex; justify-content: flex-end; }
.unfav-btn { font-size: 22rpx; color: var(--ym-red-700); border: 1rpx solid var(--ym-red-100); background: var(--ym-red-50); border-radius: 6rpx; padding: 8rpx 18rpx; }

.sk-list { }
.sk-card { padding: 26rpx 28rpx; background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-rest); margin-bottom: 18rpx; }
.sk-line { height: 22rpx; border-radius: 4rpx; background: var(--ym-paper-deep, var(--ym-paper-deep)); margin-top: 16rpx; animation: sk-pulse 1.4s ease-in-out infinite; }
.sk-line--lg { height: 32rpx; width: 60%; }
@keyframes sk-pulse { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; } }

.empty-state { padding: 180rpx 0 0; text-align: center; }
.empty-emoji { font-size: 88rpx; line-height: 1; color: var(--ym-text-3); }
.empty-title { margin-top: 24rpx; font-size: 30rpx; color: var(--ym-ink); font-weight: 650; }
.empty-sub { margin-top: 12rpx; font-size: 24rpx; color: var(--ym-text-3); padding: 0 60rpx; }
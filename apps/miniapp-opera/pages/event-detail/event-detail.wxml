<view class="container" wx:if="{{event}}">
  <view wx:if="{{loading}}" class="sk-page">
    <view class="sk-hero"></view>
    <view class="sk-card"><view class="sk-line sk-line--lg"></view><view class="sk-line"></view><view class="sk-line"></view></view>
  </view>

  <!-- 头卡 -->
  <view wx:else class="event-hero">
    <view class="hero-flag hero-flag--{{event.lifecycleStatus}}">{{event.lifecycleStatus === 'ongoing' ? '进行中' : event.lifecycleStatus === 'ended' ? '已结束' : '预告'}}</view>
    <view class="hero-title">{{event.title}}</view>
    <view wx:if="{{event.tags && event.tags.length}}" class="hero-tags">
      <text wx:for="{{event.tags}}" wx:for-item="tag" wx:key="*this" class="hero-tag">{{tag}}</text>
    </view>
  </view>

  <!-- 关键信息卡 -->
  <view wx:if="{{!loading}}" class="info-card">
    <view class="info-row">
      <view class="info-label">时间</view>
      <view class="info-value">{{timeLabel}}</view>
    </view>
    <view class="info-row">
      <view class="info-label">地址</view>
      <view class="info-value">{{event.place}}</view>
    </view>
    <view class="info-row">
      <view class="info-label">性质</view>
      <view class="info-value">{{event.free ? '免费' : '售票'}} · {{event.category}}</view>
    </view>
    <view class="info-row">
      <view class="info-label">主办</view>
      <view class="info-value">沂蒙小戏小剧官方平台建设工作组</view>
    </view>
    <view class="info-row">
      <view class="info-label">承办</view>
      <view class="info-value">{{event.place}} · 临沂市文化馆</view>
    </view>
    <view class="info-row">
      <view class="info-label">报名</view>
      <view class="sign-bar"><view class="sign-bar-fill" style="width: {{signUpPercent}}%"></view></view>
      <view class="sign-num">{{signedUp}}/{{event.capacity}}人</view>
    </view>
  </view>

  <!-- 简介 -->
  <view wx:if="{{!loading}}" class="section">
    <view class="section-title">活动介绍</view>
    <view class="desc">{{event.desc || '正式内容接入后展示。'}}</view>
  </view>

  <!-- 演出场次时间线 -->
  <view wx:if="{{!loading && performances.length}}" class="section">
    <view class="section-title">演出场次</view>
    <view class="timeline">
      <view wx:for="{{performances}}" wx:key="id" class="tl-item">
        <view class="tl-dot"></view>
        <view class="tl-card">
          <view class="tl-card-title">{{item.title}}</view>
          <view class="tl-card-meta">{{item.timeLabel}} · {{item.place}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 流程时间线 -->
  <view wx:if="{{!loading}}" class="section">
    <view class="section-title">活动流程</view>
    <view class="flow">
      <view wx:for="{{flow}}" wx:key="key" class="flow-item">
        <view class="flow-time">{{item.time}}</view>
        <view class="flow-dot"></view>
        <view class="flow-body">
          <view class="flow-title">{{item.title}}</view>
          <view class="flow-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 参演剧目 -->
  <view wx:if="{{!loading && relatedWorks.length}}" class="section">
    <view class="section-title">参演剧目</view>
    <view class="works">
      <view wx:for="{{relatedWorks}}" wx:key="id" class="work-card" data-id="{{item.id}}" bindtap="openWork">
        <view class="work-poster serif">{{item.title}}</view>
        <view class="work-body">
          <view class="work-title">《{{item.title}}》</view>
          <view class="work-meta">{{item.tag}} · {{item.organization.title}}</view>
        </view>
      </view>
    </view>
  </view>
</view>

<view wx:elif="{{error}}" class="state">
  <view class="state-emoji">📡</view>
  <view class="state-title">活动加载失败</view>
  <view class="state-sub">下拉刷新或点重试</view>
  <view class="retry-btn" bindtap="retry">重新加载</view>
</view>

<!-- 官方页脚 -->
<view wx:if="{{event && !loading}}" class="official-footer">
  <view>沂蒙小戏小剧官方数字传播平台</view>
  <view class="official-footer-sub">活动详情以官方审核发布为准</view>
</view>

<!-- 底部操作条 -->
<view wx:if="{{event && !loading}}" class="action-bar">
  <view class="action-btn" bindtap="onShare">分享</view>
  <view class="action-btn action-btn--primary {{signed ? 'action-btn--active' : ''}}" bindtap="onSign">{{signed ? '✓ 已报名' : '立即报名'}}</view>
</view>
/* 我的收藏：红金宣纸 token */
.page { min-height: 100vh; background: var(--ym-paper); padding: 28rpx 28rpx 40rpx; }

.tabs { display: flex; gap: 12rpx; margin-bottom: 28rpx; }
.tab { flex: 1; text-align: center; padding: 18rpx 0; border-radius: 10rpx; border: 1rpx solid var(--ym-line); color: var(--ym-text-2); font-size: 26rpx; background: var(--ym-surface); }
.tab--on { background: var(--ym-red-700); border-color: var(--ym-red-700); color: #FFFFFF; font-weight: 650; }

.results { padding: 0; }
.result-card { padding: 26rpx 28rpx 26rpx; margin-bottom: 18rpx; }
.result-title { font-size: 30rpx; font-weight: 650; color: var(--ym-ink); line-height: 1.4; }
.result-summary { margin-top: 10rpx; font-size: 24rpx; color: var(--ym-text-2); line-height: 1.6; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.result-meta { margin-top: 10rpx; font-size: 22rpx; color: var(--ym-text-3); }
.result-actions { margin-top: 18rpx; display: flex; justify-content: flex-end; }
.unfav-btn { font-size: 22rpx; color: var(--ym-red-700); border: 1rpx solid var(--ym-red-100); background: var(--ym-red-50); border-radius: 6rpx; padding: 8rpx 18rpx; }

/* 骨架 */
.sk-list { margin-top: 8rpx; }
.sk-card { padding: 26rpx 28rpx; background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-rest); margin-bottom: 18rpx; }
.sk-line { height: 22rpx; border-radius: 4rpx; background: var(--ym-paper-deep, #E9E0CC); margin-top: 16rpx; animation: sk-pulse 1.4s ease-in-out infinite; }
.sk-line--lg { height: 32rpx; width: 60%; }
@keyframes sk-pulse { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; } }

/* 空态 */
.empty-state { padding: 180rpx 0 0; text-align: center; }
.empty-emoji { font-size: 88rpx; line-height: 1; color: var(--ym-text-3); }
.empty-title { margin-top: 24rpx; font-size: 30rpx; color: var(--ym-ink); font-weight: 650; }
.empty-sub { margin-top: 12rpx; font-size: 24rpx; color: var(--ym-text-3); padding: 0 60rpx; }
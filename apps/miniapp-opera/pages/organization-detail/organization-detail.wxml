<view class="container">
  <view wx:if="{{loading}}" class="sk-page">
    <view class="sk-hero"></view>
    <view class="sk-name-bar"></view>
    <view class="sk-card"><view class="sk-line sk-line--lg"></view><view class="sk-line"></view></view>
  </view>

  <block wx:else wx:if="{{organization}}">
    <!-- 剧团头卡：红色渐变 + 院名 + 编号占位 -->
    <view class="org-hero">
      <view class="org-glyph">{{glyph}}</view>
    </view>
    <view class="org-name-bar">
      <text class="org-name">{{organization.title}}</text>
    </view>
    <view class="org-meta">官方剧团 · 资料持续补充中</view>

    <!-- 剧团简介 -->
    <view class="section">
      <view class="section-title">剧团简介</view>
      <view class="bio">{{organization.summary || '正式内容接入后展示。'}}</view>
    </view>

    <!-- 院团作品 -->
    <view class="section">
      <view class="section-title">代表剧目</view>
      <view wx:if="{{worksLoading}}" class="skeleton-block"></view>
      <view wx:elif="{{works.length}}" class="works">
        <view wx:for="{{works}}" wx:key="id" class="work-row" data-id="{{item.id}}" bindtap="openWork">
          <view class="work-title">《{{item.title}}》</view>
          <view class="work-meta">{{item.tag}} · {{item.artists[0].title || '剧团演员'}}</view>
        </view>
      </view>
      <view wx:else class="empty">代表剧目将在剧目 API 接入后展示</view>
    </view>

    <!-- 院团影像（按 title 反查） -->
    <view class="section" wx:if="{{videos.length}}">
      <view class="section-title">院团影像</view>
      <view wx:for="{{videos}}" wx:key="id" class="video-row" data-id="{{item.id}}" bindtap="openVideo">
        <view class="video-cover"><view class="video-duration">{{item.durationLabel}}</view></view>
        <view class="video-text">
          <view class="video-title">{{item.title}}</view>
          <view class="video-meta">{{item.category}} · {{item.sourceName}} · {{item.resolution}}</view>
        </view>
      </view>
    </view>
  </block>

  <view wx:elif="{{error}}" class="state">
    <view class="state-emoji">📡</view>
    <view class="state-title">剧团档案未找到</view>
    <view class="state-sub">下拉刷新或点重试</view>
    <view class="retry-btn" bindtap="retry">重新加载</view>
  </view>
</view>

<!-- 底部操作条 -->
<view wx:if="{{organization && !loading}}" class="action-bar">
  <view class="action-btn" bindtap="onShare">分享剧团</view>
  <view class="action-btn action-btn--primary {{followed ? 'action-btn--active' : ''}}" bindtap="onFollow">{{followed ? '✓ 已关注' : '+ 关注剧团'}}</view>
</view>
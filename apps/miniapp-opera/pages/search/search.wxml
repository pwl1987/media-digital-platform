<view class="container">
  <view class="search-bar">
    <input value="{{q}}" placeholder="搜索剧目、演员、剧团、活动" confirm-type="search" bindinput="onInput" bindconfirm="doSearch" />
    <button size="mini" bindtap="doSearch">搜索</button>
  </view>
  <view wx:if="{{results.length}}" class="search-results">
    <view wx:for="{{results}}" wx:key="id" class="card result-card" data-type="{{item.type}}" data-id="{{item.id}}" bindtap="openResult">
      <view class="result-tag">{{item.resultType}}</view>
      <view class="result-title">{{item.title}}</view>
      <view class="result-summary">{{item.summary || item.organization || '查看相关内容'}}</view>
      <view class="result-arrow">›</view>
    </view>
  </view>
  <view wx:else class="card empty">暂无搜索结果</view>
</view>

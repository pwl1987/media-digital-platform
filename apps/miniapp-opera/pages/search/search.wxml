<view class="page">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <text class="search-icon">⌕</text>
      <input class="search-input" value="{{q}}" placeholder="搜索剧目、演员、剧团、活动、影像、资讯" placeholder-class="search-ph" confirm-type="search" bindinput="onInput" bindconfirm="doSearch" />
      <view wx:if="{{q}}" class="search-clear" bindtap="clear">✕</view>
    </view>
    <view class="search-btn" bindtap="doSearch">搜索</view>
  </view>

  <!-- 检索源加载中 -->
  <view wx:if="{{loading}}" class="state">
    <view class="state-emoji">⏳</view>
    <view class="state-title">正在准备检索…</view>
    <view class="state-sub">剧目 · 演员 · 剧团 · 活动 · 影像 · 资讯</view>
  </view>

  <block wx:else>
    <!-- 结果列表 -->
    <view wx:if="{{results.length}}" class="result-count">共 {{results.length}} 条结果</view>
    <view wx:if="{{results.length}}" class="results">
      <view wx:for="{{results}}" wx:key="id" class="card result-card" data-type="{{item.type}}" data-id="{{item.id}}" bindtap="openResult">
        <view class="result-tag">{{item.label}}</view>
        <view class="result-title">{{item.title}}</view>
        <view wx:if="{{item.summary}}" class="result-summary">{{item.summary}}</view>
        <text class="result-arrow">›</text>
      </view>
    </view>

    <!-- 空态：未搜索 -->
    <view wx:if="{{!searched}}" class="empty-state">
      <view class="empty-emoji">⌕</view>
      <view class="empty-title">输入关键词开始检索</view>
      <view class="empty-sub">支持剧目 · 演员 · 剧团 · 活动 · 影像 · 资讯</view>
    </view>

    <!-- 空态：无结果 -->
    <view wx:if="{{searched && !results.length}}" class="empty-state">
      <view class="empty-emoji">🔍</view>
      <view class="empty-title">没有找到相关结果</view>
      <view class="empty-sub">换个关键词试试，或浏览各栏目</view>
    </view>
  </block>
</view>
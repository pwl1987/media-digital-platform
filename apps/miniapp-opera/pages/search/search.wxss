/* 搜索页：红金宣纸 token（OPERA_UI_VISUAL_BASELINE_V0.1） */
.page { min-height: 100vh; background: var(--ym-paper); padding: 20rpx 28rpx 40rpx; }

/* 搜索栏 */
.search-bar { display: flex; align-items: center; gap: 16rpx; }
.search-input-wrap { flex: 1; display: flex; align-items: center; gap: 12rpx; background: var(--ym-surface); border: 1rpx solid var(--ym-line); border-radius: 40rpx; padding: 0 24rpx; height: 72rpx; }
.search-icon { font-size: 32rpx; color: var(--ym-text-3); flex-shrink: 0; }
.search-input { flex: 1; font-size: 26rpx; color: var(--ym-ink); }
.search-ph { color: var(--ym-text-3); }
.search-clear { font-size: 24rpx; color: var(--ym-text-3); padding: 8rpx; flex-shrink: 0; }
.search-btn { flex-shrink: 0; background: var(--ym-red-700); color: #FFFFFF; border-radius: 40rpx; padding: 16rpx 28rpx; font-size: 26rpx; font-weight: 650; }

/* 结果 */
.result-count { margin: 32rpx 0 16rpx; font-size: 24rpx; color: var(--ym-text-3); }
.results { }
.result-card { position: relative; padding: 26rpx 40rpx; margin-bottom: 16rpx; }
.result-tag { display: inline-block; font-size: 20rpx; color: var(--ym-gold-700); background: var(--ym-gold-100); border: 1rpx solid var(--ym-gold-300); border-radius: 4rpx; padding: 4rpx 14rpx; margin-bottom: 12rpx; }
.result-title { font-size: 30rpx; font-weight: 650; color: var(--ym-ink); line-height: 1.4; }
.result-summary { margin-top: 10rpx; font-size: 24rpx; color: var(--ym-text-2); line-height: 1.6; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.result-arrow { position: absolute; right: 24rpx; top: 50%; transform: translateY(-50%); font-size: 36rpx; color: var(--ym-text-3); }

/* 空态 */
.empty-state { padding: 140rpx 0 0; text-align: center; }
.empty-emoji { font-size: 88rpx; line-height: 1; }
.empty-title { margin-top: 24rpx; font-size: 30rpx; color: var(--ym-ink); font-weight: 650; }
.empty-sub { margin-top: 12rpx; font-size: 24rpx; color: var(--ym-text-3); }

/* 加载态 */
.state { padding: 140rpx 0 0; text-align: center; }
.state-emoji { font-size: 88rpx; line-height: 1; }
.state-title { margin-top: 24rpx; font-size: 30rpx; color: var(--ym-ink); font-weight: 650; }
.state-sub { margin-top: 12rpx; font-size: 24rpx; color: var(--ym-text-3); }
/* 错误态：emoji + 主标 + 副标 + 重试（与详情页一致） */
.state { padding: 140rpx 0 0; text-align: center; }
.state-emoji { font-size: 88rpx; line-height: 1; }
.state-title { margin-top: 24rpx; font-size: 30rpx; color: var(--ym-ink); font-weight: 650; }
.state-sub { margin-top: 12rpx; font-size: 24rpx; color: var(--ym-text-3); padding: 0 80rpx; }
.retry-btn { margin: 32rpx auto 0; width: 220rpx; padding: 16rpx 0; border: 1rpx solid var(--ym-red-700); border-radius: 8rpx; color: var(--ym-red-700); font-size: 26rpx; }

/* 加载骨架 */
.sk-list { margin-top: 24rpx; }
.sk-card { padding: 26rpx 28rpx; background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-rest); margin-bottom: 18rpx; }
.sk-line { height: 22rpx; border-radius: 4rpx; background: var(--ym-paper-deep, var(--ym-paper-deep)); margin-top: 16rpx; animation: sk-pulse 1.4s ease-in-out infinite; }
.sk-line--lg { height: 32rpx; width: 60%; }
.sk-line--sm { width: 40%; }
@keyframes sk-pulse { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; } }

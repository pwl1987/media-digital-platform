.page{min-height:100vh;background:#fbf8f5;padding:34rpx 28rpx 60rpx;color:#2b2421}.header{padding:12rpx 4rpx 28rpx}.eyebrow{font-size:20rpx;letter-spacing:3rpx;color:#9b4d43;font-weight:700}.title{font-size:48rpx;font-weight:800;margin-top:8rpx}.subtitle{font-size:24rpx;color:#938883;margin-top:8rpx}.filters{white-space:nowrap;margin:0 -28rpx;padding:0 28rpx 20rpx}.filter{display:inline-block;margin-right:14rpx;padding:12rpx 22rpx;border:1px solid #e5d8d2;border-radius:999rpx;color:#7e716b;font-size:24rpx;background:#fff}.filter.active{background:#7a1f1f;color:#fff;border-color:#7a1f1f}.list{margin-top:6rpx}.item{background:#fff;border-radius:18rpx;padding:26rpx 24rpx;margin-bottom:18rpx;border:1px solid #eee2dc}.badge{display:inline-block;font-size:21rpx;color:#8f3a32;background:#f7ebe7;border-radius:7rpx;padding:6rpx 10rpx}.item-title{font-size:32rpx;font-weight:800;line-height:1.45;margin-top:12rpx}.summary{font-size:25rpx;line-height:1.7;color:#766b65;margin-top:10rpx}.meta{font-size:21rpx;color:#a29994;margin-top:16rpx}.empty{text-align:center;padding-top:180rpx;color:#9b918d;font-size:26rpx}
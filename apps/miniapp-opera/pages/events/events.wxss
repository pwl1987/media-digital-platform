/* 展演活动：日历双轴导航 + 活动卡（红金宣纸 token，吸收设计稿"活动"页模式） */
.container { min-height: 100vh; background: var(--ym-paper); padding: 34rpx 28rpx 60rpx; box-sizing: border-box; }
.page-head { padding: 4rpx 4rpx 8rpx; }
.eyebrow { font-size: 22rpx; letter-spacing: 3rpx; color: var(--ym-gold-700); font-weight: 700; }
.title { font-size: 46rpx; font-weight: 800; margin-top: 8rpx; color: var(--ym-ink); }

.search-box { margin-top: 20rpx; }
.search-input { background: var(--ym-surface); border: 1rpx solid var(--ym-line); border-radius: 8rpx; padding: 20rpx 24rpx; font-size: 26rpx; color: var(--ym-text); }

/* 日历条 */
.calendar-card { margin-top: 20rpx; background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-rest); padding: 24rpx; }
.cal-head { display: flex; align-items: center; }
.cal-title { flex: 1; font-size: 28rpx; font-weight: 700; color: var(--ym-ink); }
.cal-tip { font-size: 20rpx; color: var(--ym-text-3); }
.cal-strip { white-space: nowrap; margin-top: 20rpx; }
.cal-day { display: inline-flex; flex-direction: column; align-items: center; justify-content: center; width: 96rpx; height: 108rpx; margin-right: 14rpx; border-radius: 10rpx; background: var(--ym-paper); border: 1rpx solid var(--ym-line); }
.cal-day--on { background: var(--ym-red-700); border-color: var(--ym-red-700); }
.cal-week { font-size: 20rpx; color: var(--ym-text-3); }
.cal-day--on .cal-week { color: rgba(255,255,255,0.85); }
.cal-num { margin-top: 6rpx; font-size: 34rpx; font-weight: 700; color: var(--ym-ink); font-variant-numeric: tabular-nums; font-family: "Noto Serif SC", "Songti SC", serif; }
.cal-day--on .cal-num { color: #FFFFFF; }

/* 分类筛选 */
.cat-strip { white-space: nowrap; margin-top: 24rpx; }
.cat-chip { display: inline-block; margin-right: 14rpx; padding: 12rpx 26rpx; border-radius: 999rpx; background: var(--ym-surface); border: 1rpx solid var(--ym-line); color: var(--ym-text-2); font-size: 24rpx; }
.cat-chip--on { background: var(--ym-red-700); color: #FFFFFF; border-color: var(--ym-red-700); }

/* 活动卡 */
.event-list { margin-top: 8rpx; }
.event-card { margin-top: 20rpx; background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-rest); padding: 26rpx; }
.event-head { display: flex; align-items: center; gap: 12rpx; }
.event-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--ym-red-700); flex-shrink: 0; }
.event-card-title { font-size: 30rpx; font-weight: 700; color: var(--ym-ink); line-height: 1.4; }

.event-cover { margin-top: 20rpx; height: 260rpx; border-radius: 10rpx; background: linear-gradient(140deg, var(--ym-red-900), var(--ym-red-500)); position: relative; }
.cover-flag { position: absolute; top: 16rpx; left: 16rpx; background: var(--ym-gold-500); color: #FFFFFF; font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 4rpx; }
.cover-status { position: absolute; right: 16rpx; top: 16rpx; font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 4rpx; }
.cover-status--upcoming { background: rgba(255,255,255,0.9); color: var(--ym-red-700); }
.cover-status--ongoing { background: var(--ym-red-700); color: #FFFFFF; }
.cover-status--ended { background: rgba(31,31,31,0.5); color: #FFFFFF; }

.event-desc { margin-top: 18rpx; font-size: 26rpx; color: var(--ym-text); line-height: 1.6; }
.event-tags { margin-top: 14rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }
.event-tag { font-size: 20rpx; color: var(--ym-red-700); background: var(--ym-red-50); border-radius: 4rpx; padding: 4rpx 12rpx; }

.event-info { margin-top: 18rpx; border-top: 1rpx solid var(--ym-paper); padding-top: 18rpx; }
.event-info-row { display: flex; align-items: center; gap: 16rpx; padding: 8rpx 0; }
.info-label { flex-shrink: 0; width: 64rpx; font-size: 22rpx; color: var(--ym-text-3); }
.info-value { font-size: 24rpx; color: var(--ym-text); font-variant-numeric: tabular-nums; }
.sign-progress { flex: 1; display: flex; align-items: center; gap: 14rpx; }
.sign-bar { flex: 1; height: 10rpx; border-radius: 5rpx; background: var(--ym-paper-deep, #EFE9DC); overflow: hidden; }
.sign-bar-fill { height: 100%; background: linear-gradient(90deg, var(--ym-gold-500), var(--ym-red-700)); border-radius: 5rpx; }
.sign-num { font-size: 22rpx; color: var(--ym-red-700); font-weight: 650; font-variant-numeric: tabular-nums; flex-shrink: 0; }

.event-actions { margin-top: 20rpx; display: flex; gap: 16rpx; }
.action-btn { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 8rpx; border: 1rpx solid var(--ym-line); color: var(--ym-text-2); font-size: 26rpx; background: var(--ym-surface); }
.action-btn--primary { flex: 1.4; background: var(--ym-red-700); border-color: var(--ym-red-700); color: #FFFFFF; font-weight: 650; }

.state { text-align: center; padding-top: 120rpx; color: var(--ym-text-2); font-size: 26rpx; }
.retry-btn { margin: 24rpx auto 0; width: 200rpx; padding: 14rpx 0; border: 1rpx solid var(--ym-red-700); border-radius: 8rpx; color: var(--ym-red-700); font-size: 26rpx; }

<view class="container">
  <view class="page-head">
    <view class="eyebrow">官方展演日历</view>
    <view class="title serif">展演活动</view>
    <view class="subtitle">即将开始、正在进行与历史回顾。</view>
  </view>

  <view wx:if="{{loading}}" class="state">正在调取展演日历…</view>
  <view wx:elif="{{error}}" class="state">
    <view>活动加载失败</view>
    <view class="retry-btn" bindtap="retry">重新加载</view>
  </view>
  <view wx:elif="{{!events.length}}" class="state">暂无展演活动</view>

  <view wx:else class="event-list">
    <view wx:for="{{events}}" wx:key="id" class="event-card" data-id="{{item.id}}" bindtap="openEvent">
      <view class="date-block date-block--{{item.lifecycleStatus}}">
        <view class="date-month">{{item.month}}月</view>
        <view class="date-day">{{item.day}}</view>
      </view>
      <view class="event-body">
        <view class="event-title-row">
          <view class="event-title">{{item.title}}</view>
          <view class="event-status event-status--{{item.lifecycleStatus}}">{{item.statusLabel}}</view>
        </view>
        <view class="event-meta">{{item.timeLabel}} · {{item.place}}</view>
      </view>
      <view class="arrow">›</view>
    </view>
  </view>
</view>

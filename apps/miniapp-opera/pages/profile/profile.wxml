<view class="container">
  <!-- 未登录态引导：演示骨架，登录体系按路线暂缓 -->
  <view class="user-card">
    <view class="avatar serif">观</view>
    <view class="user-info">
      <view class="user-name">沂蒙文化爱好者</view>
      <view class="user-sub">山东 · 临沂</view>
      <view class="user-tip">登录后可同步收藏、观看历史与活动报名</view>
    </view>
  </view>

  <!-- 数据看板（真实本地持久化计数） -->
  <view class="dashboard-card">
    <view class="dash-item">
      <view class="dash-icon dash-icon--red">●</view>
      <view class="dash-value">{{stats.favorites}}</view>
      <view class="dash-label">收藏</view>
    </view>
    <view class="dash-item">
      <view class="dash-icon dash-icon--orange">●</view>
      <view class="dash-value">{{stats.signedUp}}</view>
      <view class="dash-label">活动报名</view>
    </view>
    <view class="dash-item">
      <view class="dash-icon dash-icon--blue">●</view>
      <view class="dash-value">{{stats.followed}}</view>
      <view class="dash-label">关注</view>
    </view>
    <view class="dash-item">
      <view class="dash-icon dash-icon--tan">●</view>
      <view class="dash-value">{{stats.notified}}</view>
      <view class="dash-label">直播提醒</view>
    </view>
  </view>

  <!-- 继续观看 -->
  <view class="section-label">继续观看</view>
  <scroll-view scroll-x class="cw-strip" show-scrollbar="{{false}}">
    <view wx:for="{{continueWatching}}" wx:key="id" class="cw-card" data-id="{{item.id}}" bindtap="openContinue">
      <view class="cw-cover">
        <view class="cw-play">▶</view>
      </view>
      <view class="cw-title">{{item.title}}</view>
      <view class="cw-progress"><view class="cw-bar"><view class="cw-fill" style="width: {{item.percent}}%"></view></view></view>
      <view class="cw-percent">{{item.percent}}%</view>
    </view>
  </scroll-view>

  <!-- 功能矩阵（真实计数） -->
  <view class="matrix">
    <view class="matrix-cell" data-id="favorites" bindtap="openMatrix">
      <view class="matrix-icon matrix-icon--red">★</view>
      <view class="matrix-label">我的收藏</view>
      <view class="matrix-value">{{stats.favorites}}</view>
    </view>
    <view class="matrix-cell" data-id="signup" bindtap="openMatrix">
      <view class="matrix-icon matrix-icon--orange">▣</view>
      <view class="matrix-label">活动报名</view>
      <view class="matrix-value">{{stats.signedUp}}</view>
    </view>
    <view class="matrix-cell" data-id="followed" bindtap="openMatrix">
      <view class="matrix-icon matrix-icon--blue">♥</view>
      <view class="matrix-label">我的关注</view>
      <view class="matrix-value">{{stats.followed}}</view>
    </view>
    <view class="matrix-cell" data-id="notified" bindtap="openMatrix">
      <view class="matrix-icon matrix-icon--tan">◷</view>
      <view class="matrix-label">直播提醒</view>
      <view class="matrix-value">{{stats.notified}}</view>
    </view>
  </view>

  <!-- 设置列表 -->
  <view class="menu-group">
    <view class="menu-row" bindtap="onAbout"><view class="menu-label">关于我们</view><view class="arrow">›</view></view>
    <view class="menu-row"><view class="menu-label">意见反馈</view><view class="arrow">›</view></view>
    <button class="menu-row menu-row--share" open-type="share"><view class="menu-label">分享给朋友</view><view class="arrow">›</view></button>
  </view>

  <view class="official-footer">
    <view>沂蒙小戏小剧官方数字传播平台</view>
    <view class="official-footer-sub">主管单位：沂蒙小戏小剧官方平台建设工作组</view>
  </view>
</view>

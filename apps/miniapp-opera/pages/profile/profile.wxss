/* 我的：数据看板 + 继续观看 + 功能矩阵（红金宣纸 + 设计稿四色辅助板） */
.container { min-height: 100vh; background: var(--ym-paper); padding: 0 0 60rpx; }

.user-card { background: linear-gradient(150deg, var(--ym-red-900), var(--ym-red-700)); padding: 60rpx 36rpx 90rpx; display: flex; align-items: center; gap: 24rpx; }
.avatar { width: 110rpx; height: 110rpx; border-radius: 50%; background: rgba(255,255,255,0.15); border: 1rpx solid rgba(255,255,255,0.4); color: #FFFFFF; font-size: 44rpx; display: flex; align-items: center; justify-content: center; }
.user-name { font-size: 36rpx; font-weight: 700; color: #FFFFFF; }
.user-sub { margin-top: 8rpx; font-size: 23rpx; color: rgba(255,255,255,0.75); }

/* 数据看板（四格彩色圆点） */
.dashboard-card { margin: -60rpx 28rpx 0; position: relative; background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-float); display: flex; padding: 30rpx 0; }
.dash-item { flex: 1; text-align: center; }
.dash-icon { font-size: 14rpx; color: var(--ym-surface); width: 20rpx; height: 20rpx; border-radius: 50%; margin: 0 auto 10rpx; display: flex; align-items: center; justify-content: center; }
.dash-icon--red { background: var(--ym-red-700); }
.dash-icon--orange { background: #CA6E4B; }
.dash-icon--blue { background: #57788C; }
.dash-icon--tan { background: #BC7E42; }
.dash-value { font-size: 40rpx; font-weight: 700; color: var(--ym-ink); font-variant-numeric: tabular-nums; font-family: "Noto Serif SC", "Songti SC", serif; }
.dash-label { margin-top: 6rpx; font-size: 22rpx; color: var(--ym-text-2); }

.section-label { margin: 36rpx 28rpx 0; font-size: 30rpx; font-weight: 700; color: var(--ym-ink); padding-left: 16rpx; border-left: 6rpx solid var(--ym-red-700); font-family: "Noto Serif SC", "Songti SC", serif; }

/* 继续观看（横滑进度卡） */
.cw-strip { white-space: nowrap; margin-top: 20rpx; padding-left: 28rpx; }
.cw-card { display: inline-block; width: 280rpx; margin-right: 20rpx; background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-rest); overflow: hidden; vertical-align: top; }
.cw-cover { height: 160rpx; background: linear-gradient(150deg, var(--ym-red-900), var(--ym-red-500)); display: flex; align-items: center; justify-content: center; position: relative; }
.cw-play { width: 64rpx; height: 64rpx; border-radius: 50%; background: rgba(255,255,255,0.25); border: 1rpx solid rgba(255,255,255,0.6); color: #FFFFFF; font-size: 24rpx; display: flex; align-items: center; justify-content: center; }
.cw-title { padding: 14rpx 16rpx 0; font-size: 24rpx; font-weight: 600; color: var(--ym-ink); line-height: 1.4; height: 68rpx; box-sizing: content-box; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; white-space: normal; }
.cw-progress { padding: 10rpx 16rpx 0; }
.cw-bar { height: 8rpx; border-radius: 4rpx; background: var(--ym-paper); overflow: hidden; }
.cw-fill { height: 100%; background: var(--ym-red-700); border-radius: 4rpx; }
.cw-percent { padding: 6rpx 16rpx 16rpx; font-size: 20rpx; color: var(--ym-red-700); text-align: right; font-variant-numeric: tabular-nums; }

/* 功能矩阵（2×2 四色） */
.matrix { margin: 28rpx 28rpx 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; }
.matrix-cell { background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-rest); padding: 26rpx; display: flex; flex-direction: column; }
.matrix-icon { width: 64rpx; height: 64rpx; border-radius: 12rpx; color: #FFFFFF; font-size: 30rpx; display: flex; align-items: center; justify-content: center; }
.matrix-icon--red { background: var(--ym-red-700); }
.matrix-icon--orange { background: #CA6E4B; }
.matrix-icon--blue { background: #57788C; }
.matrix-icon--tan { background: #BC7E42; }
.matrix-label { margin-top: 16rpx; font-size: 26rpx; font-weight: 650; color: var(--ym-ink); }
.matrix-value { margin-top: 4rpx; font-size: 30rpx; font-weight: 700; color: var(--ym-text-3); font-variant-numeric: tabular-nums; }

/* 设置列表 */
.menu-group { margin: 28rpx 28rpx 0; background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-rest); }
.menu-row { display: flex; align-items: center; justify-content: space-between; padding: 28rpx; border-bottom: 1rpx solid var(--ym-paper); background: transparent; width: 100%; box-sizing: border-box; font-size: 28rpx; text-align: left; }
.menu-row:last-child { border-bottom: 0; }
.menu-row::after { border: none; }
.menu-row--share { border-radius: 0; line-height: inherit; }
.menu-label { font-size: 28rpx; color: var(--ym-ink); }
.arrow { color: var(--ym-text-3); font-size: 32rpx; }

.official-footer { margin-top: 56rpx; text-align: center; font-size: 22rpx; color: var(--ym-text-3); line-height: 1.7; }
.official-footer-sub { font-size: 20rpx; }

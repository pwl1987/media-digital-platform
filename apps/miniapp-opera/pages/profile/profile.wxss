/* 我的：官方个人中心（红金宣纸 token） */
.container { min-height: 100vh; background: var(--ym-paper); padding: 0 0 60rpx; }

.user-card { background: linear-gradient(150deg, var(--ym-red-900), var(--ym-red-700)); padding: 60rpx 36rpx 70rpx; display: flex; align-items: center; gap: 24rpx; }
.avatar { width: 110rpx; height: 110rpx; border-radius: 50%; background: rgba(255,255,255,0.15); border: 1rpx solid rgba(255,255,255,0.4); color: #FFFFFF; font-size: 44rpx; display: flex; align-items: center; justify-content: center; }
.user-name { font-size: 36rpx; font-weight: 700; color: #FFFFFF; }
.user-sub { margin-top: 8rpx; font-size: 23rpx; color: rgba(255,255,255,0.75); }

.stats-card { margin: -44rpx 28rpx 0; position: relative; background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-float); display: flex; padding: 28rpx 0; }
.stat-item { flex: 1; text-align: center; }
.stat-value { font-size: 40rpx; font-weight: 700; color: var(--ym-red-700); font-variant-numeric: tabular-nums; font-family: "Noto Serif SC", "Songti SC", serif; }
.stat-label { margin-top: 6rpx; font-size: 22rpx; color: var(--ym-text-2); }

.menu-group { margin: 28rpx 28rpx 0; background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-rest); }
.menu-row { display: flex; align-items: center; gap: 20rpx; padding: 26rpx; border-bottom: 1rpx solid var(--ym-paper); }
.menu-row:last-child { border-bottom: 0; }
.menu-icon { width: 72rpx; height: 72rpx; border-radius: 10rpx; background: var(--ym-red-50); color: var(--ym-red-700); font-size: 28rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-family: "Noto Serif SC", "Songti SC", serif; }
.menu-body { flex: 1; min-width: 0; }
.menu-label { font-size: 29rpx; font-weight: 650; color: var(--ym-ink); }
.menu-desc { margin-top: 4rpx; font-size: 22rpx; color: var(--ym-text-3); }
.arrow { color: var(--ym-text-3); font-size: 34rpx; }

.official-footer { margin-top: 56rpx; text-align: center; font-size: 22rpx; color: var(--ym-text-3); line-height: 1.7; }
.official-footer-sub { font-size: 20rpx; }

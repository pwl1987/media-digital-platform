<view class="container">
  <view class="page-head">
    <view class="eyebrow">官方视听档案</view>
    <view class="title serif">影像馆</view>
  </view>

  <!-- 顶部通栏三形态切换（红/蓝/金） -->
  <scroll-view scroll-x class="vt-strip" show-scrollbar="{{false}}">
    <view wx:for="{{tabs}}" wx:key="key" class="vt-card vt-card--{{item.key}} {{activeTab === item.key ? 'vt-card--on' : ''}}" data-key="{{item.key}}" bindtap="switchTab">
      <view class="vt-label">{{item.label}}</view>
      <view class="vt-sub">{{item.sub}}</view>
    </view>
  </scroll-view>

  <scroll-view scroll-x class="cats" show-scrollbar="{{false}}">
    <view
      wx:for="{{categories}}"
      wx:key="*this"
      class="cat {{active === item ? 'cat--on' : ''}}"
      data-cat="{{item}}"
      bindtap="selectCategory"
    >{{item}}</view>
  </scroll-view>

  <view wx:if="{{loading}}" class="sk-list">
    <view wx:for="{{[1,2,3]}}" wx:key="*this" class="card sk-card">
      <view class="sk-line sk-line--lg"></view>
      <view class="sk-line"></view>
    </view>
  </view>
  <view wx:elif="{{error}}" class="state">
    <view>影像加载失败</view>
    <view class="retry-btn" bindtap="retry">重新加载</view>
  </view>
  <view wx:elif="{{activeTab !== 'works'}}" class="state">该版块内容正在接入</view>
  <view wx:elif="{{!items.length}}" class="state">该分类暂无影像</view>

  <view wx:else class="wall">
    <view wx:for="{{items}}" wx:key="id" class="media-card" data-id="{{item.id}}" bindtap="openVideo">
      <view class="cover">
        <image wx:if="{{item.coverUrl}}" class="cover-img" src="{{item.coverUrl}}" mode="aspectFill" />
        <view class="cat-tag">{{item.category}}</view>
        <view class="duration">{{item.durationLabel}}</view>
      </view>
      <view class="title">{{item.title}}</view>
      <view wx:if="{{item.tags.length}}" class="tags">
        <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tag">{{tag}}</text>
      </view>
      <view class="meta">{{item.sourceName}} · {{item.resolution}}</view>
    </view>
  </view>
</view>

<view class="page">
  <view wx:if="{{loading}}" class="state">正在加载影像…</view>
  <view wx:elif="{{error || !video}}" class="state">
    <view>影像不存在或加载失败</view>
    <view class="retry-btn" bindtap="retry">重新加载</view>
  </view>

  <block wx:else>
    <!-- 媒体组件：有播放地址走 <video>；无源走结构化占位（Gate E：无播放地址态） -->
    <video
      wx:if="{{video.url}}"
      class="player"
      src="{{video.url}}"
      poster="{{video.coverUrl}}"
      controls
      object-fit="cover"
      binderror="onPlayError"
    />
    <view wx:else class="player player--placeholder">
      <view class="player-poster">
        <image wx:if="{{video.coverUrl}}" class="poster-img" src="{{video.coverUrl}}" mode="aspectFill" />
        <view wx:else class="player-title serif">{{video.title}}</view>
      </view>
      <view class="player-note">官方影像 · 媒资接入后支持在线播放</view>
    </view>

    <view class="title">{{video.title}}</view>
    <view class="meta-row">
      <text class="meta-tag">{{video.category}}</text>
      <text class="meta">{{video.sourceName}} · {{video.resolution}} · 时长 {{video.durationLabel}}</text>
    </view>

    <!-- 传播链：影像 → 相关剧目 → 相关新闻 -->
    <view wx:if="{{relatedWork}}" class="section">
      <view class="section-title">相关剧目</view>
      <view class="work-row" bindtap="openWork">
        <view class="work-poster serif">{{relatedWork.title}}</view>
        <view class="work-text">
          <view class="work-name">《{{relatedWork.title}}》</view>
          <view class="work-meta">{{relatedWork.tag}} · {{relatedWork.organization.title}}</view>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>

    <view wx:if="{{relatedNews.length}}" class="section">
      <view class="section-title">相关新闻</view>
      <view wx:for="{{relatedNews}}" wx:key="id" class="news-row" data-id="{{item.id}}" bindtap="openNews">
        <view class="news-title">{{item.title}}</view>
        <view class="news-meta">{{item.date}} · {{item.sourceName}}</view>
      </view>
    </view>

    <view class="official-footer">沂蒙小戏小剧官方数字传播平台</view>
  </block>
</view>

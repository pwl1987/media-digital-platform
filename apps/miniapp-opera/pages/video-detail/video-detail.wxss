/* 视频详情：媒体组件 + 著录信息 + 传播链（红金宣纸 token 化） */
.page { min-height: 100vh; background: var(--ym-paper); padding: 0 0 60rpx; }

.player { width: 100%; height: 420rpx; display: block; background: var(--ym-ink); }
.player--placeholder { background: var(--ym-ink); }
.player-poster { height: 340rpx; display: flex; align-items: center; justify-content: center; }
.poster-img { width: 100%; height: 100%; }
.player-title { color: rgba(255,255,255,0.92); font-size: 40rpx; letter-spacing: 4rpx; text-align: center; padding: 0 40rpx; }
.player-note { text-align: center; color: rgba(255,255,255,0.7); font-size: 24rpx; padding: 24rpx 0; }

.title { padding: 28rpx 30rpx 0; font-size: 36rpx; font-weight: 700; color: var(--ym-ink); line-height: 1.4; }
.meta-row { padding: 16rpx 30rpx 0; display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap; }
.meta-tag { font-size: 22rpx; color: var(--ym-gold-700); background: var(--ym-gold-100); border-radius: 4rpx; padding: 6rpx 14rpx; }
.meta { font-size: 24rpx; color: var(--ym-text-3); font-variant-numeric: tabular-nums; }

.section { margin-top: 44rpx; padding: 0 30rpx; }
.section-title { font-size: 32rpx; font-weight: 700; color: var(--ym-ink); padding-left: 16rpx; border-left: 6rpx solid var(--ym-red-700); margin-bottom: 20rpx; font-family: "Noto Serif SC", "Songti SC", serif; }

.work-row { display: flex; align-items: center; gap: 20rpx; background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-rest); padding: 20rpx; }
.work-poster { width: 120rpx; height: 156rpx; border-radius: 8rpx; background: linear-gradient(160deg, var(--ym-paper), var(--ym-gold-100)); color: var(--ym-red-700); font-size: 30rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.work-text { flex: 1; min-width: 0; }
.work-name { font-size: 29rpx; font-weight: 650; color: var(--ym-ink); }
.work-meta { margin-top: 8rpx; font-size: 22rpx; color: var(--ym-text-3); }
.arrow { color: var(--ym-text-3); font-size: 32rpx; }

.news-row { padding: 22rpx 0; border-bottom: 1rpx solid var(--ym-line); }
.news-title { font-size: 28rpx; font-weight: 600; color: var(--ym-ink); line-height: 1.45; }
.news-meta { margin-top: 8rpx; font-size: 22rpx; color: var(--ym-text-3); }

.official-footer { margin-top: 40rpx; text-align: center; font-size: 22rpx; color: var(--ym-text-3); }

.state { text-align: center; padding-top: 180rpx; color: var(--ym-text-2); font-size: 26rpx; }
.retry-btn { margin: 24rpx auto 0; width: 200rpx; padding: 14rpx 0; border: 1rpx solid var(--ym-red-700); border-radius: 8rpx; color: var(--ym-red-700); font-size: 26rpx; }

.state-emoji { font-size: 88rpx; line-height: 1; }
.state-title { margin-top: 20rpx; font-size: 32rpx; color: var(--ym-ink); font-weight: 650; }
.state-sub { margin-top: 12rpx; font-size: 24rpx; color: var(--ym-text-3); padding: 0 80rpx; }

<view class="container">
  <view class="page-head">
    <view class="eyebrow">官方剧目档案</view>
    <view class="title serif">精品剧目</view>
    <view class="subtitle">从一部作品出发，认识演员、剧团与每一场演出。</view>
  </view>

  <scroll-view class="filter-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
    <view class="filter-row">
      <view wx:for="{{tags}}" wx:key="*this" class="filter {{activeTag === item ? 'filter-active' : ''}}" data-tag="{{item}}" bindtap="selectTag">{{item}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="state">正在调取剧目档案…</view>
  <view wx:elif="{{error}}" class="state">
    <view>剧目加载失败</view>
    <view class="retry-btn" bindtap="retry">重新加载</view>
  </view>
  <view wx:elif="{{!works.length}}" class="state">该分类暂无剧目</view>

  <view wx:else class="opera-grid">
    <view wx:for="{{works}}" wx:key="id" class="opera-card" data-id="{{item.id}}" bindtap="openWork">
      <view class="opera-poster">
        <image wx:if="{{item.posterUrl}}" class="opera-poster-img" src="{{item.posterUrl}}" mode="aspectFill" />
        <view wx:else class="opera-poster-fallback serif">{{item.title}}</view>
        <view class="opera-tag">{{item.tag}}</view>
      </view>
      <view class="opera-title">《{{item.title}}》</view>
      <view class="opera-summary">{{item.summary}}</view>
      <view class="opera-meta">{{item.organization.title}} · {{item.artists[0].title}}</view>
    </view>
  </view>
</view>

/* 剧目库：海报网格（与首页 opera-card 同语言，红金宣纸 token） */
.container { min-height: 100vh; background: var(--ym-paper); padding: 34rpx 28rpx 60rpx; box-sizing: border-box; }
.page-head { padding: 4rpx 4rpx 8rpx; }
.eyebrow { font-size: 22rpx; letter-spacing: 3rpx; color: var(--ym-gold-700); font-weight: 700; }
.title { font-size: 46rpx; font-weight: 800; margin-top: 8rpx; color: var(--ym-ink); }
.subtitle { margin-top: 8rpx; font-size: 24rpx; color: var(--ym-text-2); line-height: 1.6; }

.filter-scroll { white-space: nowrap; margin-top: 20rpx; padding-bottom: 12rpx; }
.filter-row { display: flex; flex-direction: row; }
.filter { display: inline-block; margin-right: 14rpx; padding: 12rpx 24rpx; border: 1rpx solid var(--ym-line); border-radius: 4rpx; color: var(--ym-text-2); font-size: 24rpx; background: var(--ym-surface); flex-shrink: 0; }
.filter-active { background: var(--ym-red-700); color: #fff; border-color: var(--ym-red-700); }

.opera-grid { margin-top: 12rpx; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20rpx; }
.opera-card { background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-rest); overflow: hidden; }
.opera-poster { height: 260rpx; background: linear-gradient(160deg, var(--ym-paper), var(--ym-gold-100)); position: relative; display: flex; align-items: center; justify-content: center; }
.opera-poster-img { width: 100%; height: 100%; }
.opera-poster-fallback { font-size: 36rpx; color: var(--ym-red-700); padding: 0 20rpx; text-align: center; }
.opera-tag { position: absolute; top: 14rpx; left: 14rpx; font-size: 20rpx; color: var(--ym-gold-700); background: var(--ym-gold-100); border-radius: 4rpx; padding: 4rpx 12rpx; }
.opera-title { padding: 16rpx 18rpx 0; font-size: 27rpx; font-weight: 650; color: var(--ym-ink); }
.opera-summary { padding: 6rpx 18rpx 0; font-size: 23rpx; color: var(--ym-text-2); line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.opera-meta { padding: 10rpx 18rpx 16rpx; font-size: 22rpx; color: var(--ym-text-3); }

.state { text-align: center; padding-top: 120rpx; color: var(--ym-text-2); font-size: 26rpx; }
.retry-btn { margin: 24rpx auto 0; width: 200rpx; padding: 14rpx 0; border: 1rpx solid var(--ym-red-700); border-radius: 8rpx; color: var(--ym-red-700); font-size: 26rpx; }

/* 加载骨架（避免白屏） */
.sk-list { padding-top: 20rpx; }
.sk-card { padding: 30rpx; margin-bottom: 20rpx; }
.sk-line { height: 22rpx; border-radius: 4rpx; background: var(--ym-paper-deep, #E9E0CC); margin-top: 18rpx; animation: sk-pulse 1.4s ease-in-out infinite; }
.sk-line--lg { height: 34rpx; width: 70%; }
.sk-line--sm { width: 40%; }
@keyframes sk-pulse { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; } }

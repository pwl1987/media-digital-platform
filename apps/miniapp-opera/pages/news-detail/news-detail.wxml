<view class="page">
  <view wx:if="{{loading}}" class="state"><view class="state-emoji">⏳</view>正在加载资讯…</view>
  <view wx:elif="{{error}}" class="state">
    <view class="state-emoji">📡</view>
    <view class="state-title">资讯加载失败</view>
    <view class="state-sub">下拉刷新或点重试</view>
    <view class="retry-btn" bindtap="retry">重新加载</view>
  </view>

  <block wx:else>
    <!-- 官方发布徽章 -->
    <view class="official-badge {{news.sourceLevelLabel === '官方发布' ? 'official-badge--red' : 'official-badge--plain'}}">{{news.sourceLevelLabel}}</view>
    <view class="title serif">{{news.title}}</view>

    <!-- 摘要引言块 -->
    <view class="quote">{{news.summary}}</view>

    <!-- 来源信息行 -->
    <view class="source-line">来源：{{news.sourceName}} · {{news.date}}</view>

    <!-- 正文 -->
    <view class="body">
      <view wx:for="{{paragraphs}}" wx:key="index" class="paragraph">{{item}}</view>
    </view>

    <!-- 传播闭环 -->
    <view wx:if="{{relatedWorks.length}}" class="section">
      <view class="section-title">相关剧目</view>
      <scroll-view scroll-x class="h-scroll">
        <view wx:for="{{relatedWorks}}" wx:key="id" class="work-chip" data-id="{{item.id}}" bindtap="openWork">
          <view class="work-chip-poster serif">{{item.title}}</view>
          <view class="work-chip-tag">{{item.tag}}</view>
          <view class="work-chip-title">《{{item.title}}》</view>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{relatedVideos.length}}" class="section">
      <view class="section-title">精彩视频</view>
      <view class="video-list">
        <view wx:for="{{relatedVideos}}" wx:key="id" class="video-row" data-id="{{item.id}}" bindtap="openVideo">
          <view class="video-cover">
            <view class="video-duration">{{item.durationLabel}}</view>
          </view>
          <view class="video-text">
            <view class="video-title">{{item.title}}</view>
            <view class="video-meta">{{item.category}} · {{item.sourceName}} · {{item.resolution}}</view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{moreNews.length}}" class="section">
      <view class="section-title">推荐阅读</view>
      <view wx:for="{{moreNews}}" wx:key="id" class="more-row" data-id="{{item.id}}" bindtap="openNews">
        <view class="more-title">{{item.title}}</view>
        <view class="more-meta">{{item.date}} · {{item.sourceName}}</view>
      </view>
    </view>

    <view class="official-footer">
      <view>沂蒙小戏小剧官方数字传播平台</view>
    </view>
  </block>
</view>

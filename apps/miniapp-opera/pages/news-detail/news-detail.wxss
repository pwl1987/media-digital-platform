/* 新闻详情：传播核心页（红金宣纸 token 化，基线 §8） */
.page { min-height: 100vh; background: var(--ym-paper); padding: 36rpx 30rpx 220rpx; }

/* 加载骨架（避免白屏） */
.page-loading { min-height: 100vh; background: var(--ym-paper); padding: 36rpx 30rpx 220rpx; }
.sk-badges { display: flex; gap: 12rpx; margin-bottom: 20rpx; }
.sk-badge { width: 96rpx; height: 36rpx; border-radius: 4rpx; background: var(--ym-paper-deep, #E9E0CC); animation: sk-pulse 1.4s ease-in-out infinite; }
.sk-line { height: 22rpx; border-radius: 4rpx; background: var(--ym-paper-deep, #E9E0CC); margin-top: 18rpx; animation: sk-pulse 1.4s ease-in-out infinite; }
.sk-line--xl { height: 48rpx; width: 90%; }
.sk-line--lg { height: 30rpx; width: 60%; }
.sk-block { height: 200rpx; border-radius: 8rpx; background: var(--ym-paper-deep, #E9E0CC); margin-top: 24rpx; animation: sk-pulse 1.4s ease-in-out infinite; }
@keyframes sk-pulse { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; } }

/* 底部操作条（固定，悬浮） */
.action-bar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; gap: 16rpx; padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom)); background: var(--ym-surface); box-shadow: 0 -4rpx 16rpx rgba(31,31,31,0.08); }
.action-btn { flex: 1; text-align: center; padding: 20rpx 0; border-radius: 10rpx; border: 1rpx solid var(--ym-line); color: var(--ym-text-2); font-size: 28rpx; background: var(--ym-surface); }
.action-btn--active { color: var(--ym-red-700); border-color: var(--ym-red-100); background: var(--ym-red-50); }

.official-badge { display: inline-block; border-radius: 4rpx; padding: 8rpx 16rpx; font-size: 24rpx; font-weight: 600; }
.official-badge--red { background: var(--ym-red-700); color: #fff; }
.official-badge--plain { background: var(--ym-surface); color: var(--ym-text-2); border: 1rpx solid var(--ym-line); }

.title { font-size: 44rpx; line-height: 1.35; font-weight: 700; margin: 24rpx 0 16rpx; color: var(--ym-ink); }

.quote { background: var(--ym-red-100); border-left: 6rpx solid var(--ym-red-700); border-radius: 8rpx; padding: 24rpx; font-size: 28rpx; line-height: 1.7; color: var(--ym-text); }

.source-line { margin-top: 20rpx; font-size: 24rpx; color: var(--ym-text-3); border-bottom: 1rpx solid var(--ym-line); padding-bottom: 24rpx; font-variant-numeric: tabular-nums; }

.body { margin-top: 32rpx; }
.paragraph { font-size: 30rpx; line-height: 1.85; color: var(--ym-text); margin-bottom: 24rpx; text-align: justify; }

.section { margin-top: 48rpx; }
.section-title { font-size: 32rpx; font-weight: 700; color: var(--ym-ink); padding-left: 16rpx; border-left: 6rpx solid var(--ym-red-700); margin-bottom: 20rpx; font-family: "Noto Serif SC", "Songti SC", serif; }

.h-scroll { white-space: nowrap; }
.work-chip { display: inline-block; width: 240rpx; margin-right: 20rpx; vertical-align: top; }
.work-chip-poster { height: 300rpx; border-radius: 12rpx; background: linear-gradient(160deg, var(--ym-paper), var(--ym-gold-100)); display: flex; align-items: center; justify-content: center; font-size: 40rpx; color: var(--ym-red-700); }
.work-chip-tag { display: inline-block; margin-top: 12rpx; font-size: 22rpx; color: var(--ym-gold-700); background: var(--ym-gold-100); border-radius: 4rpx; padding: 4rpx 12rpx; }
.work-chip-title { margin-top: 8rpx; font-size: 26rpx; font-weight: 650; color: var(--ym-ink); }

.video-row { display: flex; gap: 18rpx; background: var(--ym-surface); border-radius: 12rpx; box-shadow: var(--ym-shadow-rest); padding: 18rpx; margin-bottom: 16rpx; align-items: center; }
.video-cover { width: 220rpx; height: 130rpx; border-radius: 8rpx; background: linear-gradient(150deg, var(--ym-red-900), var(--ym-red-700)); position: relative; flex-shrink: 0; }
.video-duration { position: absolute; right: 12rpx; bottom: 12rpx; font-size: 20rpx; color: #fff; background: rgba(31,31,31,0.55); border-radius: 4rpx; padding: 4rpx 10rpx; font-variant-numeric: tabular-nums; }
.video-text { flex: 1; min-width: 0; }
.video-title { font-size: 27rpx; font-weight: 650; color: var(--ym-ink); line-height: 1.4; }
.video-meta { margin-top: 8rpx; font-size: 22rpx; color: var(--ym-text-3); }

.more-row { padding: 22rpx 0; border-bottom: 1rpx solid var(--ym-line); }
.more-title { font-size: 28rpx; font-weight: 600; color: var(--ym-ink); line-height: 1.45; }
.more-meta { margin-top: 8rpx; font-size: 22rpx; color: var(--ym-text-3); }

.official-footer { margin-top: 56rpx; text-align: center; font-size: 22rpx; color: var(--ym-text-3); }

.state { text-align: center; color: var(--ym-text-2); padding-top: 180rpx; font-size: 26rpx; }
.retry-btn { margin: 24rpx auto 0; width: 200rpx; padding: 14rpx 0; border: 1rpx solid var(--ym-red-700); border-radius: 8rpx; color: var(--ym-red-700); font-size: 26rpx; }

.state-emoji { font-size: 88rpx; line-height: 1; }
.state-title { margin-top: 20rpx; font-size: 32rpx; color: var(--ym-ink); font-weight: 650; }
.state-sub { margin-top: 12rpx; font-size: 24rpx; color: var(--ym-text-3); padding: 0 80rpx; }

.detail-row { display:flex; justify-content:space-between; padding:22rpx 0; border-bottom:1rpx solid #eee; font-size:28rpx; }
.detail-row:last-child { border-bottom:0; }
.relation-card { margin-bottom:20rpx; }
.relation-title { font-size:30rpx; font-weight:650; }
.work-list .work-card { margin-top:20rpx; }
.work-tag { display:inline-block; padding:8rpx 14rpx; border-radius:999rpx; background:#F3E7E4; color:#7A1F1F; font-size:22rpx; }
.work-title { margin-top:18rpx; font-size:32rpx; font-weight:700; }
.work-summary { margin-top:12rpx; color:#666; font-size:26rpx; line-height:1.6; }
.work-meta { margin-top:16rpx; color:#999; font-size:24rpx; }
